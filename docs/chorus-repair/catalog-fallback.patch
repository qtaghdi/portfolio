new file mode 100644
index 0000000..62bb8fc
--- /dev/null
+++ b/src/lib/server/itunes.ts
@@ -0,0 +1,34 @@
+export interface ITunesTrack {
+    trackId: number;
+    trackName: string;
+    artistName: string;
+    artworkUrl100?: string;
+    collectionName?: string;
+    previewUrl?: string;
+}
+
+/** @description Try the preferred music catalog, then another region for missing tracks. */
+export async function lookupCatalog(fetcher: typeof fetch, endpoint: 'search' | 'lookup', params: Record<string, string>): Promise<ITunesTrack[]> {
+    let completed = false;
+    for (const country of ['KR', 'US']) {
+        try {
+            const url = new URL(`https://itunes.apple.com/${endpoint}`);
+            url.search = new URLSearchParams({ ...params, country }).toString();
+            const response = await fetcher(url, { signal: AbortSignal.timeout(8000) });
+            if (!response.ok) continue;
+            const data = await response.json();
+            if (!Array.isArray(data.results)) continue;
+            completed = true;
+            const tracks = data.results.filter((track: ITunesTrack) => Number.isSafeInteger(track.trackId) && typeof track.trackName === 'string');
+            if (tracks.length) return tracks;
+        } catch { continue; }
+    }
+    if (!completed) throw new Error('Music catalogs are unavailable');
+    return [];
+}
+
+export function toTrack(track: ITunesTrack) {
+    return { id: track.trackId, title: track.trackName, artist: track.artistName,
+        cover: track.artworkUrl100?.replace(/\/\d+x\d+[^/]*\.jpg/, '/1000x1000bb.jpg'),
+        album: track.collectionName, audio: track.previewUrl };
+}
