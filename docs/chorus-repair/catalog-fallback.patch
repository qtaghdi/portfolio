diff --git a/tests/itunes.test.ts b/tests/itunes.test.ts
new file mode 100644
index 0000000..a379bc0
--- /dev/null
+++ b/tests/itunes.test.ts
@@ -0,0 +1,27 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+const { lookupCatalog } = await import(new URL('../src/lib/server/itunes.ts', import.meta.url).href);
+const track = { trackId: 123, trackName: 'Example', artistName: 'Artist' };
+test('search and lookup fall back from an empty Korean catalog to US', async () => {
+    for (const endpoint of ['search', 'lookup'] as const) {
+        const countries: string[] = [];
+        const fetcher = (async (input: URL) => {
+            const country = input.searchParams.get('country')!; countries.push(country);
+            return Response.json({ results: country === 'US' ? [track] : [] });
+        }) as typeof fetch;
+        assert.deepEqual(await lookupCatalog(fetcher, endpoint, { term: 'Example' }), [track]);
+        assert.deepEqual(countries, ['KR', 'US']);
+    }
+});
+test('successful empty searches differ from unavailable catalogs', async () => {
+    const empty = (async () => Response.json({ results: [] })) as typeof fetch;
+    assert.deepEqual(await lookupCatalog(empty, 'search', { term: 'Missing' }), []);
+    const unavailable = (async () => new Response('', { status: 503 })) as typeof fetch;
+    await assert.rejects(lookupCatalog(unavailable, 'search', { term: 'Example' }), /unavailable/);
+});
+test('usable Korean results do not query another region', async () => {
+    let calls = 0;
+    const fetcher = (async () => { calls++; return Response.json({ results: [track] }); }) as typeof fetch;
+    assert.deepEqual(await lookupCatalog(fetcher, 'search', { term: 'Example' }), [track]);
+    assert.equal(calls, 1);
+});
