---
import { copy, type Locale } from '../i18n';
import { socialImagePath } from '../lib/social-image.mjs';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const locale = Astro.props.locale ?? 'ko';
const dictionary = copy[locale];
const title = Astro.props.title ?? dictionary.meta.title;
const description = Astro.props.description ?? dictionary.meta.description;
const currentPath = Astro.url.pathname;
const koPath = currentPath.startsWith('/en/') ? currentPath.slice(3) || '/' : currentPath;
const enPath = currentPath.startsWith('/en/') ? currentPath : `/en${currentPath === '/' ? '/' : currentPath}`;
const canonical = new URL(currentPath, Astro.site ?? Astro.url.origin);
const koUrl = new URL(koPath, Astro.site ?? Astro.url.origin);
const enUrl = new URL(enPath, Astro.site ?? Astro.url.origin);
const socialImage = new URL(Astro.props.image ?? socialImagePath(currentPath, locale), Astro.site ?? Astro.url.origin);
const imageAlt = Astro.props.imageAlt ?? title;
---
<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ko" href={koUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={koUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={locale === 'ko' ? '박상민 포트폴리오' : 'Park Sangmin Portfolio'} />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ko' ? 'en_US' : 'ko_KR'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="preload" href="/fonts/Pretendard-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Pretendard-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon-32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" sizes="any" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{dictionary.skip}</a>
    <slot />

  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/global.scss';
</style>
