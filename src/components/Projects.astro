---
import { getCollection, type CollectionEntry } from 'astro:content';
import { copy, projectPath, type Locale } from '../i18n';
import { projectEn, projectKey } from '../i18n/projects';
import ProjectVisual from './ProjectVisual.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dictionary = copy[locale].selected;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured);
const more = projects.filter((project) => !project.data.featured);

const localized = (project: CollectionEntry<'projects'>) => {
  if (locale === 'ko') return project.data;
  const translation = projectEn[projectKey(project.slug)];
  return { ...project.data, ...translation };
};
---

<section id="projects" class="projects-section">
  <div class="shell">
    <header class="section-head reveal">
      <p class="eyebrow">{dictionary.kicker}</p>
      <h2>{dictionary.title.split('\n').map((line) => <span>{line}</span>)}</h2>
      <p class="section-description">{dictionary.description}</p>
    </header>

    <div class="selected-list">
      {featured.map((project, index) => {
        const data = localized(project);
        const key = projectKey(project.slug);
        return (
          <article class:list={['selected-row', { active: index === 0 }]} data-project-row>
            <a class="row-main" href={projectPath(locale, project.slug)}>
              <span class="row-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="row-title">{data.title}</span>
              <span class="row-category">{data.category}</span>
              <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M7 4h9v9" /></svg>
            </a>
            <div class="row-detail">
              <div class="row-copy">
                <p>{data.thesis}</p>
                <dl>
                  {data.evidence.slice(0, 3).map((item) => (
                    <div><dt>{item.val}</dt><dd>{item.label}</dd></div>
                  ))}
                </dl>
                <a href={projectPath(locale, project.slug)}>
                  {dictionary.detail}
                  <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M7 4h9v9" /></svg>
                </a>
              </div>
              <div class="row-visual">
                <div aria-hidden={key === 'notiiv' ? undefined : 'true'}><ProjectVisual projectKey={key} locale={locale} variant="compact" /></div>
                <a class="visual-link" href={projectPath(locale, project.slug)} aria-label={`${data.title} ${dictionary.detail}`}></a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <section id="more-work" class="more-work reveal" aria-labelledby="more-work-title">
      <header>
        <p class="eyebrow">{dictionary.moreKicker}</p>
        <h2 id="more-work-title">{dictionary.moreTitle}</h2>
        <p>{dictionary.moreDescription}</p>
      </header>
      <ol>
        {more.map((project, index) => {
          const data = localized(project);
          return (
            <li>
              <a href={projectPath(locale, project.slug)}>
                <span class="more-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="more-name"><strong>{data.title}</strong><small>{data.badge ?? data.category}</small></span>
                <span class="more-year">{data.year}</span>
                <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M7 4h9v9" /></svg>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;
  .projects-section { padding: clamp(110px, 13vw, 190px) 0; }
  .section-head { display: grid; grid-template-columns: .55fr 1.35fr .65fr; gap: 48px; align-items: end; margin-bottom: 72px; }
  .section-head h2 { font-size: clamp(2.5rem, 5.2vw, 5.7rem); font-weight: 500; line-height: 1.02; letter-spacing: -.065em; }
  .section-head h2 span { display: block; word-break: keep-all; }
  .section-description { max-width: 390px; color: $silver; font-size: 1rem; line-height: 1.82; word-break: keep-all; }
  .selected-list { border-top: 1px solid $line-bright; }
  .selected-row {
    min-height: clamp(560px, 76svh, 720px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid $line;
    opacity: .82;
    transition: opacity $mid;
  }
  .selected-row.active { opacity: 1; }
  .row-main {
    min-height: 116px;
    display: grid;
    grid-template-columns: 58px minmax(220px, 1fr) minmax(180px, .5fr) 24px;
    align-items: center;
    gap: 26px;
  }
  .row-number, .row-category { color: #a5a5ad; font: 500 .68rem/1.45 $font-mono; }
  .row-title { font-size: clamp(1.75rem, 3.5vw, 3.5rem); font-weight: 500; letter-spacing: -.045em; }
  .row-category { text-align: right; text-transform: uppercase; }
  .row-main svg, .row-copy a svg, .more-work svg { width: 18px; fill: none; stroke: currentColor; stroke-width: 1.2; }
  .row-detail {
    height: 380px;
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 64px;
    overflow: hidden;
    opacity: .5;
    transform: translateY(10px);
    filter: saturate(.6);
    transition: opacity $mid, transform $mid, filter $mid;
  }
  .selected-row.active .row-detail { opacity: 1; transform: none; filter: none; }
  .row-copy { display: flex; flex-direction: column; padding: 34px 0 44px 84px; }
  .row-copy > p { max-width: 520px; color: #dedee3; font-size: 1.08rem; line-height: 1.78; word-break: keep-all; }
  .row-copy dl { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 42px; border-top: 1px solid $line; }
  .row-copy dl > div { padding: 16px 12px 0 0; }
  .row-copy dt { font: 500 .94rem/1.2 $font-mono; }
  .row-copy dd { margin-top: 7px; color: #aaaab2; font-size: .74rem; line-height: 1.55; }
  .row-copy a { width: fit-content; display: flex; align-items: center; gap: 9px; margin-top: auto; color: #dedee3; font: 500 .7rem/1 $font-mono; letter-spacing: .06em; }
  .row-visual { position: relative; min-width: 0; height: 332px; overflow: hidden; border: 1px solid $line; background: $black-soft; }
  .row-visual > div { width: 100%; height: 100%; }
  .visual-link { position: absolute; z-index: 8; inset: 0; cursor: pointer; }
  .visual-link:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
  .row-visual:has(.visual-link:hover) { border-color: rgba(255,255,255,.48); }
  .more-work { margin-top: clamp(130px, 16vw, 230px); }
  .more-work > header { display: grid; grid-template-columns: .55fr 1fr .65fr; gap: 48px; align-items: end; margin-bottom: 48px; }
  .more-work h2 { font-size: clamp(2rem, 4vw, 4.1rem); font-weight: 500; letter-spacing: -.055em; }
  .more-work header > p:last-child { max-width: 390px; color: $silver; font-size: .96rem; line-height: 1.8; }
  .more-work ol { display: grid; grid-template-columns: 1fr 1fr; column-gap: 80px; list-style: none; border-top: 1px solid $line-bright; }
  .more-work li { border-bottom: 1px solid $line; }
  .more-work li a { min-height: 94px; display: grid; grid-template-columns: 36px 1fr 54px 18px; align-items: center; gap: 16px; }
  .more-number, .more-year { color: $gunmetal; font: 500 .65rem/1 $font-mono; }
  .more-name { min-width: 0; }
  .more-name strong { display: block; overflow: hidden; font-size: 1rem; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
  .more-name small { display: block; margin-top: 7px; color: $gunmetal; font: 500 .63rem/1.25 $font-mono; text-transform: uppercase; }
  .more-work li a:hover .more-name strong, .row-main:hover .row-title { color: $silver; }
  @media (max-width: 920px) {
    .section-head, .more-work > header { grid-template-columns: 1fr; gap: 22px; }
    .section-description, .more-work header > p:last-child { max-width: 560px; }
    .row-detail { grid-template-columns: 1fr; gap: 24px; }
    .selected-row { min-height: 780px; }
    .row-detail { height: 620px; }
    .row-copy { padding-left: 84px; }
    .more-work ol { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .selected-row { min-height: min(88svh, 760px); }
    .row-main { min-height: 96px; grid-template-columns: 30px 1fr 18px; gap: 12px; }
    .row-category { display: none; }
    .row-title { font-size: 1.55rem; }
    .row-copy { padding: 24px 0 36px; }
    .row-copy dl { gap: 12px; }
    .row-detail { height: 590px; }
    .row-visual { height: 280px; }
    .more-work li a { grid-template-columns: 28px 1fr 18px; }
    .more-year { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .selected-row, .row-detail { transition: none; }
  }
</style>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-project-row]'));
  const activate = (row: HTMLElement) => {
    rows.forEach((item) => item.classList.toggle('active', item === row));
  };
  rows.forEach((row) => {
    row.addEventListener('focusin', () => activate(row));
  });

  const focusObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) activate(entry.target as HTMLElement);
    });
  }, { rootMargin: '-43% 0px -43% 0px', threshold: 0 });

  rows.forEach((row) => focusObserver.observe(row));
</script>
