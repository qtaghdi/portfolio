---
import { getCollection, type CollectionEntry } from 'astro:content';
import { copy, projectPath, type Locale } from '../i18n';
import { projectEn, projectKey } from '../i18n/projects';
import ProjectVisual from './ProjectVisual.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dictionary = copy[locale].selected;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured);
const more = projects.filter((project) => !project.data.featured);
const localized = (project: CollectionEntry<'projects'>) => {
  if (locale === 'ko') return project.data;
  return { ...project.data, ...projectEn[projectKey(project.slug)] };
};
const notes = locale === 'ko' ? {
  notiiv: {
    title: '반복되던 기반을 하나의 규칙으로',
    body: '앱마다 따로 존재하던 인증, API, 공유 로직을 공통 구조로 옮기고 운영 화면의 실제 작업 흐름까지 함께 다듬었습니다.',
    labels: ['4개 프론트엔드 앱', '13개 공통 패키지', '공통 패키지 테스트 90%+'],
  },
  'design-system': {
    title: '화면을 만드는 기준을 배포 가능한 제품으로',
    body: '토큰과 컴포넌트 API뿐 아니라 접근성, 반응형 레이아웃, Storybook 검증과 NPM 릴리즈까지 하나의 운영 흐름으로 연결했습니다.',
    labels: ['Token', 'Component API', 'Storybook', 'Release'],
  },
  'document-workspace': {
    title: '편집 UI와 저장 모델을 같은 문제로',
    body: '사람과 AI가 같은 XLSX를 편집할 때 생기는 revision 충돌, undo와 redo, 원자적 저장을 화면과 서버 양쪽에서 함께 설계했습니다.',
    labels: ['Editor', 'MCP', 'Revision', 'Persistence'],
  },
} : {
  notiiv: {
    title: 'One set of rules for repeated foundations',
    body: 'I moved authentication, API, and sharing logic from individual apps into shared structure, while improving real operational workflows.',
    labels: ['4 frontend apps', '13 shared packages', '90%+ shared package tests'],
  },
  'design-system': {
    title: 'A deployable product for building interfaces',
    body: 'I connected tokens and component APIs with accessibility, responsive layouts, Storybook validation, and NPM releases.',
    labels: ['Token', 'Component API', 'Storybook', 'Release'],
  },
  'document-workspace': {
    title: 'One problem across editing and persistence',
    body: 'I designed revision conflicts, undo and redo, and atomic saves across both UI and server for shared XLSX editing.',
    labels: ['Editor', 'MCP', 'Revision', 'Persistence'],
  },
};
---

<section id="projects" class="projects-section">
  <div class="shell">
    <header class="section-head reveal">
      <p>Work / 2025-2026</p>
      <h2>{dictionary.title}</h2>
      <p>{dictionary.description}</p>
    </header>

    <div class="featured-list">
      {featured.map((project, index) => {
        const data = localized(project);
        const key = projectKey(project.slug) as keyof typeof notes;
        const note = notes[key];
        return (
          <article class:list={['featured-project', `project-${key}`, 'reveal']}>
            <header class="project-head">
              <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p>{data.category} / {data.year}</p>
                <h3><a href={projectPath(locale, project.slug)}>{data.title}</a></h3>
              </div>
              <p class="project-thesis">{data.thesis ?? data.summary}</p>
            </header>

            <div class="project-body">
              <a class="project-media" href={projectPath(locale, project.slug)} aria-label={`${data.title} ${dictionary.detail}`}>
                <ProjectVisual projectKey={key} locale={locale} variant="compact" />
              </a>
              <aside class="project-note">
                <p>{locale === 'ko' ? '제가 맡은 문제' : 'Problem I owned'}</p>
                <h4>{note.title}</h4>
                <p class="note-body">{note.body}</p>
                {key === 'notiiv' ? (
                  <ul class="fact-list">{note.labels.map((label) => <li>{label}</li>)}</ul>
                ) : key === 'design-system' ? (
                  <div class="token-strip">{note.labels.map((label, itemIndex) => <span><i style={`--tone:${itemIndex}`}></i>{label}</span>)}</div>
                ) : (
                  <div class="flow-note">{note.labels.map((label, itemIndex) => <span>{label}{itemIndex < note.labels.length - 1 && <i>→</i>}</span>)}</div>
                )}
                <a class="case-link" href={projectPath(locale, project.slug)}>{dictionary.detail}<span aria-hidden="true">↗</span></a>
              </aside>
            </div>
          </article>
        );
      })}
    </div>

    <section id="more-work" class="more-work reveal" aria-labelledby="more-work-title">
      <header>
        <h2 id="more-work-title">{dictionary.moreTitle}</h2>
        <p>{dictionary.moreDescription}</p>
      </header>
      <ol>
        {more.map((project, index) => {
          const data = localized(project);
          const key = projectKey(project.slug);
          return (
            <li class:list={{ intranet: key === 'intranet' }}>
              <a href={projectPath(locale, project.slug)}>
                <span class="more-number">{String(index + 1).padStart(2, '0')}</span>
                {key === 'intranet' && <img src="/projects/intranet/icon.png" width="52" height="52" alt={locale === 'ko' ? 'Bigtablet Intranet 앱 아이콘' : 'Bigtablet Intranet app icon'} />}
                <span class="more-name"><strong>{data.title}</strong><small>{data.summary}</small></span>
                <span class="more-year">{data.year}</span>
                <span class="more-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;
  .projects-section { padding: clamp(90px, 10vw, 140px) 0 clamp(105px, 12vw, 170px); }
  .section-head { display: grid; grid-template-columns: .28fr 1.18fr .54fr; gap: clamp(40px, 6vw, 92px); align-items: end; padding-bottom: 42px; border-bottom: 1px solid $silver-bright; }
  .section-head > p:first-child { align-self: start; color: $accent; font: 600 .62rem/1.4 $font-mono; }
  .section-head h2, .more-work h2 { font-size: clamp(2.7rem, 5vw, 5rem); font-weight: 500; line-height: 1; letter-spacing: -.06em; }
  .section-head > p:last-child, .more-work header p { color: $silver; font-size: .92rem; line-height: 1.78; word-break: keep-all; }
  .featured-project { padding: clamp(72px, 9vw, 126px) 0; border-bottom: 1px solid $line-bright; }
  .project-head { display: grid; grid-template-columns: .28fr 1.18fr .54fr; gap: clamp(40px, 6vw, 92px); align-items: end; }
  .project-number { align-self: start; color: $accent; font: 600 .7rem/1 $font-mono; }
  .project-head > div > p { color: $gunmetal; font: 500 .62rem/1.4 $font-mono; }
  .project-head h3 { margin-top: 13px; font-size: clamp(2.6rem, 5.3vw, 5.7rem); font-weight: 500; line-height: .98; letter-spacing: -.065em; }
  .project-head h3 a:hover { color: $accent; }
  .project-thesis { color: $silver; font-size: 1rem; line-height: 1.7; word-break: keep-all; }
  .project-body { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, .5fr); gap: clamp(42px, 6vw, 86px); align-items: start; margin-top: 52px; }
  .project-media { height: clamp(390px, 45vw, 650px); overflow: hidden; border: 1px solid $line; background: $black-soft; transition: border-color $fast; }
  .project-media:hover { border-color: $silver-bright; }
  .project-note { padding-top: 16px; border-top: 1px solid $silver-bright; }
  .project-note > p:first-child { color: $accent; font: 600 .61rem/1 $font-mono; }
  .project-note h4 { margin-top: 24px; font-size: clamp(1.3rem, 2vw, 1.75rem); font-weight: 600; line-height: 1.38; letter-spacing: -.03em; word-break: keep-all; }
  .note-body { margin-top: 19px; color: $silver; font-size: .9rem; line-height: 1.78; word-break: keep-all; }
  .fact-list { margin-top: 28px; list-style: none; border-top: 1px solid $line; }
  .fact-list li { padding: 11px 0; border-bottom: 1px solid $line; color: $gunmetal; font: 500 .66rem/1.5 $font-mono; }
  .token-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 15px 12px; margin-top: 31px; }
  .token-strip span { display: flex; align-items: center; gap: 9px; color: $gunmetal; font: 500 .6rem/1.3 $font-mono; }
  .token-strip i { width: 16px; height: 16px; border-radius: 50%; background: hsl(calc(12 + var(--tone) * 22), calc(74% - var(--tone) * 10%), calc(54% + var(--tone) * 9%)); }
  .flow-note { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 30px; }
  .flow-note span { display: flex; align-items: center; gap: 7px; color: $gunmetal; font: 500 .6rem/1.3 $font-mono; }
  .flow-note i { color: $accent; font-style: normal; }
  .case-link { display: flex; align-items: center; justify-content: space-between; margin-top: 34px; padding: 14px 0 9px; border-bottom: 1px solid $silver-bright; font-size: .75rem; font-weight: 600; }
  .case-link:hover { color: $accent; }
  .more-work { padding-top: clamp(100px, 12vw, 170px); }
  .more-work > header { display: grid; grid-template-columns: 1fr minmax(300px, .45fr); gap: 70px; align-items: end; margin-bottom: 45px; }
  .more-work ol { list-style: none; border-top: 1px solid $silver-bright; }
  .more-work li { border-bottom: 1px solid $line; }
  .more-work li a { min-height: 92px; display: grid; grid-template-columns: 45px 1fr auto 20px; align-items: center; gap: 18px; }
  .more-work li.intranet a { grid-template-columns: 45px 54px 1fr auto 20px; }
  .more-work li a:hover .more-name strong, .more-work li a:hover .more-arrow { color: $accent; }
  .more-work img { width: 50px; height: 50px; border-radius: 12px; box-shadow: 0 4px 12px rgba(21,22,21,.12); }
  .more-number, .more-year { color: $gunmetal; font: 500 .61rem/1 $font-mono; }
  .more-name { min-width: 0; }
  .more-name strong { display: block; font-size: 1rem; font-weight: 600; transition: color $fast; }
  .more-name small { display: block; max-width: 740px; margin-top: 5px; overflow: hidden; color: $gunmetal; font-size: .72rem; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
  .more-arrow { transition: color $fast; }
  @media (max-width: 960px) {
    .section-head, .project-head { grid-template-columns: .2fr 1fr; }
    .section-head > p:last-child, .project-thesis { grid-column: 2; margin-top: 10px; }
    .project-body { grid-template-columns: 1fr; }
    .project-note { max-width: 620px; }
  }
  @media (max-width: 680px) {
    .projects-section { padding-top: 70px; }
    .section-head, .project-head { grid-template-columns: 32px 1fr; gap: 15px; }
    .section-head { padding-bottom: 30px; }
    .section-head > p:first-child { font-size: 0; }
    .section-head > p:first-child::after { content: '01'; font-size: .62rem; }
    .section-head h2, .more-work h2 { font-size: 2.55rem; }
    .section-head > p:last-child, .project-thesis { grid-column: 2; }
    .featured-project { padding: 62px 0; }
    .project-head h3 { font-size: 2.75rem; }
    .project-body { gap: 34px; margin-top: 35px; }
    .project-media { height: 64vw; min-height: 250px; }
    .more-work > header { grid-template-columns: 1fr; gap: 20px; }
    .more-work li a, .more-work li.intranet a { min-height: 86px; grid-template-columns: 29px auto 1fr 18px; gap: 12px; }
    .more-work li:not(.intranet) .more-name { grid-column: 2 / 4; }
    .more-work img { width: 44px; height: 44px; border-radius: 10px; }
    .more-year { display: none; }
    .more-name small { max-width: 210px; }
  }
</style>
