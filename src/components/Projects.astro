---
import { getCollection, type CollectionEntry } from 'astro:content';
import { copy, projectPath, type Locale } from '../i18n';
import { projectEn, projectKey } from '../i18n/projects';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const ko = locale === 'ko';
const dictionary = copy[locale].selected;
const groupLabels = ko ? { company: '회사 프로젝트', team: '협업 프로젝트', personal: '개인 프로젝트' } : { company: 'Company project', team: 'Team project', personal: 'Personal project' };
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const localized = (project: CollectionEntry<'projects'>) => locale === 'ko' ? project.data : { ...project.data, ...projectEn[projectKey(project.slug)] };
const projectIcons: Record<string, string> = {
  'design-system': '/projects/design-system/favicon.png',
  notiiv: '/projects/notiiv/favicon.svg',
  'document-workspace': '/projects/document-workspace/icon.svg',
  intranet: '/projects/intranet/icon.png',
  boundra: '/projects/boundra/icon.svg',
  owkr: '/projects/owkr/favicon.webp',
  jeomjuro: '/projects/jeomjuro/non-favicon.svg',
  marker: '/projects/marker/icon.png',
  'rust-with-typescript': '/projects/rust-with-typescript/favicon.svg',
  kivra: '/projects/kivra/icon.svg',
  homepage: '/projects/design-system/favicon.png',
  echo: '/projects/echo/icon.svg',
  chorus: '/projects/chorus/favicon.svg',
  'apple-music-discord-presence': '/projects/apple-music-discord-presence/favicon.svg',
};
const moreNotes: Record<string, string> = ko ? {
  intranet: '메일, 메신저와 업무 메뉴를 연결한 사내 모바일 앱',
  boundra: 'NPM으로 배포한 도메인 경계 검사 Rust CLI',
  owkr: '명단 공동 편집과 시험·모집을 연결한 커뮤니티 도구',
  jeomjuro: '점주 커뮤니티의 알림·글쓰기·관리자 도구',
  marker: '감정과 장소를 기록하는 지도 서비스',
  'rust-with-typescript': '14개 챕터와 예제 실행을 제공하는 Rust 학습 가이드',
  kivra: '터미널·IDE 실행 기록을 모으는 로컬 데스크톱 도구',
  homepage: '회사 홈페이지의 다국어·반응형 화면 개선',
  echo: '실시간 음성 감지와 그룹 통계 앱',
  chorus: '음악과 메시지를 3D 바이닐 카드로 만드는 웹앱',
  'apple-music-discord-presence': 'Apple Music·Discord 연결과 복구를 다루는 설치형 도구',
} : {
  intranet: 'An internal mobile app for mail, messaging, and work',
  boundra: 'A domain-boundary Rust CLI distributed through NPM',
  owkr: 'Community tools for shared rosters, exams, and recruitment',
  jeomjuro: 'Notifications, writing, and moderation for a store-owner community',
  marker: 'A map for recording emotions and places',
  'rust-with-typescript': 'A deployed 14-chapter Rust guide with runnable examples',
  kivra: 'A local desktop tool collecting terminal and IDE runs',
  homepage: 'Bilingual and responsive company website improvements',
  echo: 'A real-time voice detection and group statistics app',
  chorus: 'A web app turning music and messages into 3D vinyl cards',
  'apple-music-discord-presence': 'An installable Apple Music to Discord tool with connection recovery',
};
const notes: Record<string, { summary: string; meta: string; role: string }> = {
  owkr: {
    summary: ko ? '여러 운영자가 명단을 함께 고치고, 팀 편성과 시험·모집을 이어갈 수 있도록 개선했습니다.' : 'Improved shared roster editing, team setup, exams, and recruitment for community operators.',
    meta: 'TypeScript · React · SvelteKit · Python',
    role: ko ? '공동 편집, 답안 저장, 모집과 복구 흐름' : 'Collaboration, answer saving, recruitment, and recovery',
  },
  'design-system': {
    summary: ko ? '필요한 컴포넌트의 CSS만 불러오도록 배포 구조를 개선했습니다.' : 'Changed package distribution to load CSS for the components in use.',
    meta: 'React · TypeScript · SCSS',
    role: ko ? '패키지 배포 구조, 토큰, 컴포넌트 유지보수' : 'Package distribution, tokens, and component maintenance',
  },
  notiiv: {
    summary: ko ? '여러 앱에서 반복되는 인증과 API 처리를 공통 패키지로 정리했습니다.' : 'Consolidated repeated authentication and API handling into shared packages.',
    meta: 'Next.js · TanStack Query · Zod',
    role: ko ? 'BFF 공통화, 운영 화면, 공유 흐름 개선' : 'Shared BFF, operator interfaces, and sharing flows',
  },
  'document-workspace': {
    summary: ko ? '사람과 AI가 같은 문서를 편집하고, 충돌이나 저장 실패 뒤에도 작업을 이어가도록 만들었습니다.' : 'Built shared document editing for people and AI, with recovery from conflicts and failed saves.',
    meta: 'Go · TypeScript · MCP',
    role: ko ? '문서 세션, 변경 충돌, 저장과 복구' : 'Document sessions, revision conflicts, persistence, and recovery',
  },
};
---
<section id="projects" class="projects-section">
  <div class="shell">
    <header class="section-head">
      <h2>{dictionary.title}</h2><p class="years">2025-2026</p>
      <p class="section-description">{dictionary.description}</p>
    </header>
    <div class="featured-list">
      {projects.filter((project) => project.data.featured).map((project, index) => {
        const data = localized(project);
        const key = projectKey(project.slug);
        const note = notes[key];
        const icon = projectIcons[key];
        const href = projectPath(locale, project.slug);
        return (
          <article class="featured-project" data-project-group={project.data.group}>
            <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="project-copy">
              <p class="project-context">{project.data.group === 'personal' ? (ko ? '개인 프로젝트 · 독립 개발' : 'Personal project · Independent work') : groupLabels[project.data.group]}</p>
              <h3><a class="project-title" href={href}>{icon && <img class="project-icon" src={icon} width="24" height="24" alt="" aria-hidden="true" decoding="async" />}{data.title}</a></h3>
              <p class="project-summary">{note?.summary ?? data.summary}</p>
              <p class="project-meta">{note?.meta ?? data.category}</p>
              <p class="project-role">{ko ? '담당' : 'Scope'}: {note?.role ?? data.role}</p>
            </div>
            <a class="case-link" href={href} aria-label={`${data.title} ${dictionary.detail}`}>{dictionary.detail}<svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" /></svg></a>
          </article>
        );
      })}
    </div>
    <section id="more-work" class="more-work" aria-labelledby="more-work-title">
      <h2 id="more-work-title">{dictionary.moreTitle}</h2>
      <ol>{projects.filter((project) => !project.data.featured).map((project) => {
        const data = localized(project);
        return <li><a href={projectPath(locale, project.slug)}><strong>{projectIcons[projectKey(project.slug)] && <img class="project-icon" src={projectIcons[projectKey(project.slug)]} width="24" height="24" alt="" aria-hidden="true" decoding="async" loading="lazy" />}<span>{data.title}</span></strong><span class="more-summary"><small class="work-type">{groupLabels[project.data.group]}</small>{moreNotes[projectKey(project.slug)] ?? data.summary}</span><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" /></svg></a></li>;
      })}</ol>
    </section>
  </div>
</section>
<style lang="scss">
  @use '../styles/tokens' as *;
  .projects-section { padding-bottom: 100px; }
  .section-head { display: grid; grid-template-columns: 1fr auto; gap: 16px 24px; padding-bottom: 32px; }
  h2 { font-size: 32px; font-weight: 600; letter-spacing: -.035em; line-height: 1.4; }
  .years { align-self: center; color: $silver; font-size: 14px; }
  .section-description { grid-column: 1 / -1; color: $silver; font-size: 17px; }
  .featured-list { border-top: 1px solid $line; }
  .featured-project { display: grid; grid-template-columns: 68px minmax(0,1fr) auto; gap: 24px; padding: 36px 0; border-bottom: 1px solid $line; }
  .project-number { padding-top: 8px; color: $gunmetal; font-size: 14px; }
  .project-context { margin-bottom: 8px; color: $gunmetal; font-size: 13px; line-height: 1.6; }
  .featured-project[data-project-group="personal"] .project-context { color: $accent; font-weight: 500; }
  h3 { font-size: 26px; font-weight: 600; line-height: 1.5; letter-spacing: -.025em; }
  .project-title { display: flex; align-items: center; gap: 12px; width: fit-content; }
  .project-title:hover { color: $accent; }
  .project-icon { width: 24px; height: 24px; object-fit: contain; flex: 0 0 24px; }
  .project-summary { margin-top: 8px; color: $silver; font-size: 17px; line-height: 1.75; word-break: keep-all; }
  .project-meta { margin-top: 10px; color: $gunmetal; font-size: 14px; }
  .project-role { margin-top: 14px; color: $silver; font-size: 15px; line-height: 1.7; }
  .case-link { display: inline-flex; align-items: center; gap: 8px; align-self: start; min-height: 44px; color: $accent; font-size: 15px; white-space: nowrap; text-decoration: underline; text-underline-offset: 4px; }
  svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.4; }
  .more-work { padding-top: 72px; }
  .more-work h2 { margin-bottom: 24px; font-size: 26px; }
  .more-work ol { list-style: none; border-top: 1px solid $line; }
  .more-work li { border-bottom: 1px solid $line; }
  .more-work li a { display: grid; grid-template-columns: 230px minmax(0,1fr) 20px; gap: 24px; min-height: 80px; align-items: center; padding: 18px 0; }
  .more-work strong { display: flex; align-items: center; gap: 12px; min-width: 0; font-size: 16px; font-weight: 600; }
  .more-work strong span { min-width: 0; overflow-wrap: anywhere; }
  .work-type { display: block; margin-bottom: 2px; color: $gunmetal; font-size: 12px; }
  .more-summary { color: $silver; font-size: 14px; line-height: 1.7; }
  .more-work li a:hover strong, .more-work li a:hover svg { color: $accent; }
  @media (max-width: 680px) {
    .projects-section { padding-bottom: 64px; }
    h2 { font-size: 26px; }.section-description { font-size: 16px; }.years { font-size: 12px; }
    .featured-project { grid-template-columns: 24px minmax(0,1fr); gap: 12px; padding: 28px 0; }
    h3 { font-size: 20px; overflow-wrap: anywhere; }.project-title { align-items: flex-start; gap: 10px; }.project-icon { margin-top: 3px; }
    .project-number { padding-top: 5px; font-size: 12px; }
    .project-summary { font-size: 16px; }.project-meta { font-size: 13px; }.project-role { font-size: 14px; }
    .case-link { grid-column: 2; margin-top: 0; font-size: 14px; width: fit-content; }
    .more-work { padding-top: 52px; }.more-work h2 { font-size: 23px; }
    .more-work li a { grid-template-columns: minmax(0,1fr) 20px; gap: 8px 16px; }
    .more-summary { grid-column: 1; grid-row: 2; padding-left: 36px; }.more-work li svg { grid-column: 2; grid-row: 1 / 3; }
  }
</style>
