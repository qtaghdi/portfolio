---
import type { Locale } from '../i18n';
import NotiivLogo from './project-visuals/NotiivLogo.astro';

interface Props {
  projectKey: string;
  locale: Locale;
  variant?: 'compact' | 'detail';
}

const { projectKey, locale, variant = 'compact' } = Astro.props;
const ko = locale === 'ko';
const waveform = [32, 58, 44, 76, 52, 88, 62, 40, 72, 48, 82, 56, 34, 68, 46, 78, 54, 38, 64, 42];
const owkrRoster = [
  { name: 'Alpha#1001', ranks: '다3★ · 플2? · 플3' },
  { name: 'Bravo#1002', ranks: '플1 · 다4★ · 플2' },
  { name: 'Charlie#1003', ranks: '플3 · 다2? · 골1' },
  { name: 'Delta#1004', ranks: '다5★ · 플1? · 플2' },
  { name: 'Echo#1005', ranks: '플2 · 다3? · 다4' },
];
const owkrRows = [
  { role: 'TANK', left: 'Delta#1004', leftRank: '다5', right: 'Hotel#1008', rightRank: '다4' },
  { role: 'DPS', left: 'Bravo#1002', leftRank: '다4', right: 'Echo#1005', rightRank: '다3' },
  { role: 'DPS', left: 'Golf#1007', leftRank: '플3', right: 'Juliet#1010', rightRank: '플4' },
  { role: 'SUPPORT', left: 'Alpha#1001', leftRank: '플3', right: 'Foxtrot#1006', rightRank: '다3' },
  { role: 'SUPPORT', left: 'Charlie#1003', leftRank: '골1', right: 'India#1009', rightRank: '미배치' },
];
---

<div class:list={['project-visual', variant]} data-visual={projectKey}>
  {projectKey === 'notiiv' && (
    <div class="mock mock-notiiv" data-notiiv-switcher data-active-app="support">
      <aside class="notiiv-rail">
        <div class="notiiv-brand"><img src="/projects/notiiv/favicon.svg" alt="" aria-hidden="true" /><NotiivLogo size={15} /></div>
        <small class="repo-label">{ko ? '제품 모노레포' : 'Product monorepo'}</small>
        <div class="notiiv-apps" role="tablist" aria-label={ko ? '노티브 앱 화면' : 'Notiiv app screens'}>
          <button id={`notiiv-admin-tab-${variant}`} type="button" role="tab" data-notiiv-tab="admin" aria-controls={`notiiv-admin-panel-${variant}`} aria-selected="false"><i aria-hidden="true">▦</i><span><b>{ko ? '어드민' : 'Admin'}</b><small>{ko ? '운영 관리' : 'Operations'}</small></span></button>
          <button id={`notiiv-owner-tab-${variant}`} type="button" role="tab" data-notiiv-tab="owner" aria-controls={`notiiv-owner-panel-${variant}`} aria-selected="false"><i aria-hidden="true">◉</i><span><b>{ko ? '오너 대시보드' : 'Owner dashboard'}</b><small>{ko ? '조직과 고객 관리' : 'Organization and clients'}</small></span></button>
          <button id={`notiiv-status-tab-${variant}`} type="button" role="tab" data-notiiv-tab="status" aria-controls={`notiiv-status-panel-${variant}`} aria-selected="false"><i aria-hidden="true">●</i><span><b>{ko ? '서비스 상태' : 'Service status'}</b><small>{ko ? '가동 상태 확인' : 'Uptime status'}</small></span></button>
          <button id={`notiiv-support-tab-${variant}`} class="active" type="button" role="tab" data-notiiv-tab="support" aria-controls={`notiiv-support-panel-${variant}`} aria-selected="true"><i aria-hidden="true"><img src="/projects/notiiv/mark.svg" alt="" /></i><span><b>{ko ? '고객지원' : 'Support'}</b><small>{ko ? '서비스 소개' : 'Product introduction'}</small></span></button>
        </div>
        <div class="notiiv-packages">
          <small>{ko ? '12개 공통 패키지' : '12 shared packages'}</small>
          <strong>api · query · schema<br />ui · theme · layouts</strong>
        </div>
      </aside>

      <div class="notiiv-stage">
        <section id={`notiiv-admin-panel-${variant}`} class="notiiv-panel notiiv-admin-view" role="tabpanel" aria-labelledby={`notiiv-admin-tab-${variant}`} data-notiiv-panel="admin" hidden>
          <aside class="notiiv-product-sidebar">
            <NotiivLogo size={17} />
            <nav><span>✉ {ko ? '문의 관리' : 'Inquiries'}</span><span>？ {ko ? 'FAQ 관리' : 'FAQ'}</span><span>◇ {ko ? '공지 등록' : 'Notices'}</span><span class="active">○ {ko ? '유저 관리' : 'Users'}</span><span>⌂ {ko ? '조직 관리' : 'Organizations'}</span><span>▤ {ko ? '로그 조회' : 'Logs'}</span></nav>
            <small>{ko ? '관리자 계정' : 'Admin account'}</small>
          </aside>
          <main class="notiiv-admin-main">
            <header><div><small>{ko ? '운영 관리' : 'Operations'}</small><h3>{ko ? '유저 관리' : 'Users'}</h3></div><span>PROD</span></header>
            <div class="notiiv-admin-filters"><label><small>{ko ? '이메일' : 'Email'}</small><span>{ko ? '이메일 검색' : 'Search email'}</span></label><label><small>{ko ? '이름' : 'Name'}</small><span>{ko ? '이름 검색' : 'Search name'}</span></label><button type="button" tabindex="-1">{ko ? '검색' : 'Search'}</button></div>
            <div class="notiiv-admin-table">
              <header><span>{ko ? '이름' : 'Name'}</span><span>{ko ? '이메일' : 'Email'}</span><span>{ko ? '가입일' : 'Joined'}</span><span>{ko ? '상태' : 'Status'}</span></header>
              <div><b>김도윤</b><span>doyun@notiiv.ai</span><span>2026.07.28</span><em>{ko ? '활성' : 'Active'}</em></div>
              <div><b>이서연</b><span>seoyeon@bigtablet.com</span><span>2026.07.24</span><em>{ko ? '활성' : 'Active'}</em></div>
              <div><b>박지훈</b><span>jihoon@example.com</span><span>2026.07.18</span><em class="muted">{ko ? '대기' : 'Pending'}</em></div>
            </div>
          </main>
        </section>

        <section id={`notiiv-owner-panel-${variant}`} class="notiiv-panel notiiv-owner-view" role="tabpanel" aria-labelledby={`notiiv-owner-tab-${variant}`} data-notiiv-panel="owner" hidden>
          <aside class="notiiv-product-sidebar owner"><NotiivLogo size={17} /><nav><span class="active">◎ {ko ? '팀원' : 'Members'}</span><span>□ {ko ? '후속 일정' : 'Calendar'}</span><span>♙ {ko ? '고객' : 'Clients'}</span></nav><small>{ko ? '고객센터' : 'Support'}</small></aside>
          <main class="notiiv-owner-main">
            <header><div><i>BT</i><span><h3>{ko ? '빅태블릿' : 'Bigtablet'}</h3><small>{ko ? '조직 대시보드' : 'Organization dashboard'}</small></span></div><div><label>{ko ? '이름으로 검색...' : 'Search by name...'}</label><button type="button" tabindex="-1">{ko ? '팀원 초대' : 'Invite member'}</button></div></header>
            <div class="notiiv-summary-grid"><article><small>{ko ? '현재 플랜' : 'Current plan'}</small><b>BUSINESS</b></article><article><small>{ko ? '팀원 / 라이선스' : 'Members / licenses'}</small><b>8 <i>/ 12</i></b></article><article><small>{ko ? '다음 결제일' : 'Next billing'}</small><b>2026.09.01</b></article><article><small>{ko ? '크레딧' : 'Credits'}</small><b>{ko ? '무제한' : 'Unlimited'}</b></article></div>
            <div class="notiiv-member-list"><header><b>{ko ? '팀원 목록' : 'Members'}</b><small>8 {ko ? '명' : 'members'}</small></header><div><span><i>김</i><b>김성태</b></span><span>MASTER</span><em>{ko ? '활성' : 'Active'}</em></div><div><span><i>박</i><b>박상민</b></span><span>ADMIN</span><em>{ko ? '활성' : 'Active'}</em></div><div><span><i>이</i><b>이서연</b></span><span>MEMBER</span><em>{ko ? '활성' : 'Active'}</em></div></div>
          </main>
        </section>

        <section id={`notiiv-status-panel-${variant}`} class="notiiv-panel notiiv-status-view" role="tabpanel" aria-labelledby={`notiiv-status-tab-${variant}`} data-notiiv-panel="status" hidden>
          <header><div><NotiivLogo size="var(--notiiv-header-logo-size, 17px)" /><span>STATUS</span></div><nav><span>한국어⌄</span><i>☼</i></nav></header>
          <main><section><h3>{ko ? '모든 시스템이 정상 운영 중입니다' : 'All systems are operational'}</h3><p>{ko ? '전체 서버가 정상적으로 응답하고 있습니다.' : 'All servers are responding normally.'}</p></section><div class="notiiv-server-list">{['SERVER-A', 'SERVER-B', 'SERVER-C'].map((server) => <article><header><b>{server}</b><span><i></i>{ko ? '정상' : 'Operational'}</span></header><div>{Array.from({ length: 28 }, (_, index) => <i class:list={{ dim: index === 10 || index === 21 }}></i>)}</div><small>99.99% uptime</small></article>)}</div><footer><span>{ko ? '마지막 업데이트 11:42:08' : 'Last updated 11:42:08'}</span><span>{ko ? '1분마다 자동으로 새로고침됩니다' : 'Refreshes every minute'}</span></footer></main>
        </section>

        <section id={`notiiv-support-panel-${variant}`} class="notiiv-panel notiiv-support-view" role="tabpanel" aria-labelledby={`notiiv-support-tab-${variant}`} data-notiiv-panel="support">
          <header><NotiivLogo size="var(--notiiv-header-logo-size, 17px)" /><nav><span>{ko ? '소개' : 'About'}</span><span>{ko ? '플랜' : 'Plans'}</span><span>{ko ? '고객센터' : 'Support'}</span><button type="button" tabindex="-1">{ko ? '로그인' : 'Sign in'}</button></nav></header>
          <main><div class="notiiv-support-copy"><h3>{ko ? <>미팅 종료, 그 즉시 시작되는<br />당신의 스마트 비즈니스<br /><NotiivLogo size="1em" /></> : <>The moment your meeting ends,<br />your smart business begins<br /><NotiivLogo size="1em" /></>}</h3><div class="notiiv-store-badges" aria-label={ko ? '앱 다운로드' : 'Download the app'}><img src={`/projects/notiiv/store/${ko ? 'ko' : 'en'}/google-play.svg`} alt={ko ? 'Google Play에서 다운로드' : 'Get it on Google Play'} /><img src={`/projects/notiiv/store/${ko ? 'ko' : 'en'}/app-store.svg`} alt={ko ? 'App Store에서 다운로드' : 'Download on the App Store'} /></div></div>
            <section class="notiiv-phone">
              <div class="phone-status"><span>9:30</span><i></i></div><div class="phone-title">{ko ? '녹음중' : 'Recording'}</div><div class="meeting-info"><strong>{ko ? '김성태님 미팅' : 'Meeting with Seongtae Kim'}</strong><span>2026.05.12</span><small>{ko ? '빅태블릿 본사 · 9층 회의실' : 'Bigtablet HQ · Meeting Room 9F'}</small></div><div class="waveform">{waveform.map((height, index) => <i style={`--bar-height:${height}%; --bar-index:${index}`}></i>)}</div><div class="record-button"><span></span></div><strong class="record-time">00:38</strong><div class="memo-mode"><i></i>{ko ? '메모 화면 모드' : 'Memo mode'}</div>
            </section>
          </main>
        </section>
      </div>
    </div>
  )}

  {projectKey === 'design-system' && (
    <div class="mock mock-ds">
      <aside class="ds-sidebar">
        <header><span class="ds-cube"><i></i></span><strong>Bigtablet</strong><b>•••</b></header>
        <div class="ds-search"><span>⌕</span>{ko ? '컴포넌트 찾기' : 'Find components'}<kbd>⌘ K</kbd></div>
        <nav>
          <b>⌄ GETTING STARTED</b>
          <span class="active">▤ Introduction</span>
          <span>▤ How to use</span>
          <b>› COOKBOOK</b>
          <b>› EXAMPLES</b>
          <b>⌄ FOUNDATION</b>
          <span>◉ Colors</span>
          <span>A Typography</span>
          <span>▦ Spacing</span>
          <b>⌄ COMPONENTS</b>
          <span>◇ Button</span>
          <span>◇ TextField</span>
          <span>◇ Sidebar</span>
        </nav>
      </aside>
      <main class="ds-story">
        <header class="ds-toolbar"><span>Introduction / Docs</span><div><i></i><i></i><i></i><i></i></div></header>
        <article>
          <small>GETTING STARTED</small>
          <h2>Introduction</h2>
          <p>{ko ? '빅태블릿 제품에서 사용하는 공통 컴포넌트와 디자인 토큰을 Storybook에서 확인합니다.' : 'Browse shared components and design tokens used across Bigtablet products in Storybook.'}</p>
          <hr />
          <h3>Bigtablet Design System</h3>
          <div class="ds-preview-row"><button>Primary</button><button class="outline">Secondary</button><label><span>Label</span><input value="Text field" readonly /></label></div>
        </article>
      </main>
    </div>
  )}

  {projectKey === 'intranet' && (
    <div class="mock mock-intranet">
      <aside class="intranet-context">
        <small>FLUTTER MOBILE APP</small>
        <strong>{ko ? '업무의 시작과 이동을 하나의 앱 셸로' : 'One app shell for daily work'}</strong>
        <dl>
          <div><dt>Flutter</dt><dd>iOS · Android</dd></div>
          <div><dt>BLoC</dt><dd>{ko ? '상태 관리' : 'State'}</dd></div>
          <div><dt>SQLite</dt><dd>{ko ? '오프라인 캐시' : 'Offline cache'}</dd></div>
        </dl>
      </aside>
      <section class="intranet-phone">
        <div class="intranet-status"><span>9:41</span><i></i></div>
        <header><strong>{ko ? '홈' : 'Home'}</strong><span>●</span></header>
        <main>
          <div class="intranet-stats">
            <article><i>○</i><strong>4</strong><small>{ko ? '알림' : 'Alerts'}</small></article>
            <article><i>□</i><strong>2</strong><small>{ko ? '대기 결재' : 'Approvals'}</small></article>
            <article><i>◇</i><strong>7</strong><small>{ko ? '메일' : 'Mail'}</small></article>
          </div>
          <section class="intranet-calendar">
            <header><strong>{ko ? '일정' : 'Calendar'}</strong><span>{ko ? '전체' : 'View all'}</span></header>
            <div class="week"><span>월<small>3</small></span><span>화<small>4</small></span><span class="today">수<small>5</small></span><span>목<small>6</small></span><span>금<small>7</small></span></div>
            <p><i></i><strong>{ko ? '제품 주간 회의' : 'Weekly product meeting'}</strong><small>10:00 · Meeting Room A</small></p>
          </section>
          <section class="intranet-notice"><header><strong>{ko ? '최근 공지' : 'Recent notices'}</strong><span>SSE · LIVE</span></header><p>{ko ? '8월 전사 일정 안내' : 'August company schedule'}<small>{ko ? '오늘' : 'Today'}</small></p></section>
        </main>
        <footer><span class="active"><i>⌂</i>{ko ? '홈' : 'Home'}</span><span><i>◇</i>{ko ? '메신저' : 'Messenger'}<b></b></span><span><i>▦</i>{ko ? '전체' : 'Apps'}</span></footer>
      </section>
      <section class="intranet-sync">
        <small>APP FLOW</small>
        <div><span class="active">HOME</span><span>MESSENGER</span><span>WORK APPS</span></div>
        <article><i></i><p><strong>{ko ? '캐시부터 즉시 표시' : 'Cache appears first'}</strong><small>SQLite · cache-then-network</small></p></article>
        <article><i></i><p><strong>{ko ? '실시간 상태 병합' : 'Merge live state'}</strong><small>SSE · FCM · deep link</small></p></article>
        <article><i></i><p><strong>{ko ? '부분 실패를 명시' : 'Expose partial failure'}</strong><small>BLoC · recovery state</small></p></article>
      </section>
    </div>
  )}

  {projectKey === 'boundra' && (
    <div class="mock mock-boundra">
      <section class="boundra-intro">
        <small>OPEN SOURCE · RUST CLI</small>
        <strong>BOUNDRA</strong>
        <p>{ko ? '아키텍처가 흐려지기 전에 실패하는 도메인 경계' : 'Domain boundaries that fail before architecture drifts.'}</p>
        <div><span>BR-001</span><span>BR-002</span><span>BR-003</span><span>BR-004</span><span>BR-005</span></div>
      </section>
      <section class="boundra-terminal">
        <header><div><span></span><span></span><span></span></div><strong>boundra · check-boundaries</strong><small>Rust CLI</small></header>
        <main>
          <p><i>$</i> pnpm exec boundra check-boundaries</p>
          <p class="muted">Scanning TypeScript domain graph...</p>
          <section class="diagnostic">
            <div><b>BR-004</b><span>DOMAIN INTERNAL IMPORT</span><em>ERROR</em></div>
            <strong>domains/order/client/view.ts:18:7</strong>
            <code>import {'{ createOrder }'} from '../payment/internal/create-order';</code>
            <p>{ko ? '다른 도메인의 내부 구현을 직접 참조할 수 없습니다.' : 'A domain cannot import another domain internal module.'}</p>
            <small>SUGGESTION · import from domains/payment/public</small>
          </section>
          <footer><span>10,000 files</span><span>5 stable rules</span><strong>164.20 ms</strong></footer>
        </main>
      </section>
    </div>
  )}

  {projectKey === 'owkr' && (
    <div class="mock mock-owkr">
      <header class="owkr-app-header">
        <strong>OWKR Balance</strong>
        <nav><span class="scrim">▦ 내전 관리</span><span class="sheet">▤ 유저 시트</span><span>▱ 매칭 가이드</span></nav>
        <small>운영자</small>
      </header>
      <main class="owkr-dashboard">
        <aside class="owkr-sidebar">
          <section class="owkr-card owkr-roster-summary">
            <header><div><i>♙</i><strong>참가 명단</strong></div><b>10/10</b></header>
            <p>입력과 대조는 넓은 참가자 작업실에서 관리합니다.</p>
            <div class="owkr-progress"><i></i></div>
            <dl><div><dt>◷ 대기열</dt><dd>0명</dd></div><div><dt>◉ 정보 보완</dt><dd>0명</dd></div></dl>
            <button>참가자 추가·관리 <span>→</span></button>
          </section>
          <section class="owkr-card owkr-player-list">
            <header><strong>♙ 참가자 관리 <small>총 10명</small></strong><span>전체 삭제</span></header>
            <div class="owkr-tabs"><b>♙ 참가자 <em>10/10</em></b><span>◷ 대기열 <em>0</em></span></div>
            <ul>{owkrRoster.map((player) => <li><strong>{player.name}</strong><small>{player.ranks}</small></li>)}</ul>
          </section>
        </aside>
        <section class="owkr-result">
          <header class="owkr-result-head"><strong>팀 배정 결과</strong><div><span>☆ 선호 무시</span><span>↻ 결과 지우기</span><b>⌘ 팀 자동 배정</b></div></header>
          <section class="owkr-card owkr-balance-summary">
            <header><strong>▥ 밸런스 요약</strong><small>1팀 11,300 · 2팀 10,760</small></header>
            <dl>
              <div class="total"><dt>총점 차이</dt><dd>540</dd></div>
              <div><dt>탱커</dt><dd>2팀 +200점</dd></div>
              <div><dt>딜러</dt><dd>2팀 +20점</dd></div>
              <div><dt>힐러</dt><dd class="blue">1팀 +390점</dd></div>
            </dl>
            <div class="owkr-exceptions"><span>선호 역할 이탈 <b>1명</b></span><span>비선호 배정 <b>1명</b></span><span>미배치 역할 <b>1명</b></span></div>
          </section>
          <div class="owkr-swap-guide">↔ 결과표에서 플레이어 두 명을 차례로 선택하면 자리를 바꿀 수 있습니다</div>
          <div class="owkr-rank-toggle">탱·딜·힐 티어 표시 <i><b></b></i></div>
          <section class="owkr-matchup">
            <header><div><strong>1팀</strong><span>선공격</span></div><div><span>선수비</span><strong>2팀</strong></div></header>
            {owkrRows.map((row, index) => (
              <div class="owkr-match-row">
                <span class="player left">{index < 2 && <i>★</i>}<strong>{row.left}</strong><small>◇ {row.leftRank}</small></span>
                <span class:list={['owkr-role', row.role.toLowerCase()]}>
                  {row.role === 'TANK' && <svg viewBox="0 0 32 32"><path d="M16 2.5 3.5 6.5S2 20 16 29.5C30 20 28.5 6.5 28.5 6.5Z" /></svg>}
                  {row.role === 'DPS' && <svg viewBox="0 0 32 32"><path d="m6 26 5-20h4.5l-5 20Zm7.5 0 5-20H23l-5 20Zm7.5 0 5-20h4.5l-5 20Z" /></svg>}
                  {row.role === 'SUPPORT' && <svg viewBox="0 0 32 32"><path d="M13 5h6v8h8v6h-8v8h-6v-8H5v-6h8Z" /></svg>}
                </span>
                <span class="player right"><small>{row.rightRank} ◇</small><strong>{row.right}</strong>{index === 4 && <i>★</i>}</span>
              </div>
            ))}
          </section>
        </section>
      </main>
    </div>
  )}

  {projectKey === 'jeomjuro' && (
    <div class="mock mock-jeomjuro">
      <section class="jeomjuro-consumer-surface">
