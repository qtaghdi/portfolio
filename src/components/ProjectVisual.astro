<script>
  const setupNotiivSwitchers = () => {
    document.querySelectorAll<HTMLElement>('[data-notiiv-switcher]').forEach((switcher) => {
      if (switcher.dataset.switcherReady === 'true') return;
      switcher.dataset.switcherReady = 'true';

      const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-notiiv-tab]'));
      const panels = Array.from(switcher.querySelectorAll<HTMLElement>('[data-notiiv-panel]'));

      const activate = (app: string, focus = false) => {
        switcher.dataset.activeApp = app;
        tabs.forEach((tab) => {
          const selected = tab.dataset.notiivTab === app;
          tab.classList.toggle('active', selected);
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          if (selected && focus) tab.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.notiivPanel !== app;
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', (event) => {
          event.stopPropagation();
          if (tab.dataset.notiivTab) activate(tab.dataset.notiivTab);
        });
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(event.key)) return;
          event.preventDefault();
          const direction = event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1;
          const next = tabs[(index + direction + tabs.length) % tabs.length];
          if (next.dataset.notiivTab) activate(next.dataset.notiivTab, true);
        });
      });

      activate(switcher.dataset.activeApp ?? 'support');
    });
  };

  setupNotiivSwitchers();
  document.addEventListener('astro:page-load', setupNotiivSwitchers);
</script>
