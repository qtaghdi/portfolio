  .notiiv-status-view { overflow: hidden; background: #fff; color: #24262c; }
  .notiiv-status-view > header { height: 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; border-bottom: 1px solid #e2e4e8; }
  .notiiv-status-view > header > div { display: flex; align-items: center; gap: 10px; }
  .notiiv-status-view > header > div span { padding-left: 10px; border-left: 1px solid #d9dbe0; color: #747780; font: 600 7px/1 $font-mono; letter-spacing: .06em; }
  .notiiv-status-view > header nav { display: flex; align-items: center; gap: 13px; color: #60636b; font-size: 6px; }
  .notiiv-status-view > header nav i { font-size: 11px; font-style: normal; }
  .notiiv-status-view > main { width: min(82%, 620px); margin: 0 auto; padding: 24px 0; }
  .notiiv-status-view > main > section { padding: 14px 17px; border-radius: 8px; background: #2e9b62; color: #fff; }
  .notiiv-status-view > main > section h3 { margin: 0; font-size: 13px; }
  .notiiv-status-view > main > section p { margin-top: 4px; font-size: 6px; opacity: .85; }
  .notiiv-server-list { margin-top: 13px; overflow: hidden; border: 1px solid #e0e2e6; border-radius: 8px; box-shadow: 0 3px 8px rgba(32,36,44,.04); }
  .notiiv-server-list article { padding: 10px 14px; border-bottom: 1px solid #e9ebee; }
  .notiiv-server-list article:last-child { border-bottom: 0; }
  .notiiv-server-list article header { display: flex; align-items: center; justify-content: space-between; }
  .notiiv-server-list article header b { font-size: 7px; }
  .notiiv-server-list article header span { display: flex; align-items: center; gap: 5px; color: #27814f; font-size: 6px; font-weight: 700; }
  .notiiv-server-list article header span i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .notiiv-server-list article > div { display: grid; grid-template-columns: repeat(28, 1fr); gap: 2px; margin-top: 8px; }
  .notiiv-server-list article > div i { height: 10px; border-radius: 2px; background: #48b97b; }
  .notiiv-server-list article > div i.dim { background: #b9ddc8; }
  .notiiv-server-list article > small { display: block; margin-top: 5px; color: #858891; font-size: 5px; text-align: right; }
  .notiiv-status-view footer { display: flex; justify-content: space-between; margin-top: 10px; color: #8b8e96; font-size: 5.5px; }

  .notiiv-support-view { --bt-color-text-heading: #fff; background: #111118; color: #f7f7fa; }
  .notiiv-support-view > header { height: 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 25px; border-bottom: 1px solid #2a2a31; background: #111118; }
  .notiiv-support-view > header nav { display: flex; align-items: center; gap: 17px; color: #dedee5; font-size: 6px; font-weight: 600; }
  .notiiv-support-view > header nav button { padding: 6px 10px; border: 0; border-radius: 5px; background: var(--bt-gradient-brand); color: #fff; font-size: 6px; font-weight: 700; }
  .notiiv-support-view > main { height: calc(100% - 52px); display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 12px; padding: 16px 34px; }
  .notiiv-support-copy h3 { margin: 0; font-size: clamp(18px, 2.7vw, 35px); font-weight: 650; line-height: 1.38; letter-spacing: -.045em; }
  .notiiv-support-copy h3 > :global(.notiiv-wordmark) { display: inline-block; }
  .notiiv-store-badges { display: flex; align-items: center; gap: 7px; margin-top: 20px; }
  .notiiv-store-badges img { width: clamp(76px, 8.2vw, 116px); height: auto; display: block; }
  .notiiv-phone { display: flex; flex-direction: column; align-items: center; justify-self: center; width: min(76%, 205px); height: min(94%, 380px); overflow: hidden; border: 4px solid #e5e5e5; border-radius: 22px; background: #fff; color: #1d1b20; box-shadow: 0 22px 50px rgba(0,0,0,.42); }
  .phone-status { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 11px 17px 4px; font-size: 9px; }
  .phone-status i { width: 20px; height: 5px; border-radius: 3px; background: #1d1b20; }
  .phone-title { width: 100%; padding: 8px; text-align: center; font-size: 13px; }
  .meeting-info { display: grid; gap: 4px; margin-top: 12px; text-align: center; }
  .meeting-info strong { font-size: 12px; }
  .meeting-info span, .meeting-info small { color: #999; font-size: 8px; }
  .waveform { width: 78%; height: 36px; display: flex; align-items: center; justify-content: center; gap: 3px; margin-top: 16px; }
  .waveform i { width: 3px; height: var(--bar-height); border-radius: 3px; background: #c2272f; animation: wave 1.8s calc(var(--bar-index) * -60ms) ease-in-out infinite alternate; }
  .record-button { display: grid; width: 52px; height: 52px; margin-top: 10px; place-items: center; border-radius: 50%; background: #c2272f; box-shadow: 0 0 18px rgba(194,39,47,.35); }
  .record-button span { width: 15px; height: 15px; border-radius: 4px; background: white; }
  .record-time { margin-top: 7px; font-size: 15px; }
  .memo-mode { display: flex; align-items: center; gap: 5px; margin-top: 10px; padding: 5px 8px; border: 1px solid #e5e5e5; border-radius: 6px; color: #666; font-size: 8px; font-weight: 600; }
  .memo-mode i { width: 8px; height: 8px; border: 1px solid #999; }

  /* Bigtablet design system, matched to the actual Storybook manager and docs canvas */
  .mock-ds { display: grid; grid-template-columns: 205px 1fr; background: #f8f9fb; color: #26262b; font-family: Arial, sans-serif; }
  .ds-sidebar { display: flex; min-width: 0; flex-direction: column; padding: 12px 10px; border-right: 1px solid #d9dce3; background: #eef1f6; }
  .ds-sidebar > header { display: flex; height: 32px; align-items: center; gap: 8px; padding: 0 6px; }
  .ds-sidebar > header strong { font-size: 13px; letter-spacing: -.02em; }
  .ds-sidebar > header b { margin-left: auto; color: #768092; font-size: 8px; }
  .ds-cube { position: relative; width: 20px; height: 20px; display: grid; place-items: center; border-radius: 5px; background: #111827; }
  .ds-cube::before, .ds-cube::after, .ds-cube i { content: ''; position: absolute; width: 9px; height: 9px; border: 1px solid #fff; transform: rotate(30deg) skewY(-30deg) scaleY(.86); }
  .ds-cube::before { translate: -3px 2px; }
  .ds-cube::after { translate: 3px -2px; }
  .ds-cube i { translate: 0 0; opacity: .7; }
  .ds-search { height: 29px; display: flex; align-items: center; gap: 6px; margin-top: 10px; padding: 0 8px; border: 1px solid #c8cdd8; border-radius: 5px; background: #fff; color: #6b7280; font-size: 8px; }
  .ds-search span { color: #4b5563; font-size: 14px; }
  .ds-search kbd { margin-left: auto; padding: 2px 4px; border: 1px solid #d6dae2; border-radius: 3px; background: #f6f7f9; color: #89909d; font-size: 6px; }
  .ds-sidebar nav { display: flex; min-height: 0; flex-direction: column; gap: 1px; margin-top: 10px; overflow: hidden; }
  .ds-sidebar nav b { margin: 9px 5px 3px; color: #687386; font-size: 7px; letter-spacing: .04em; }
  .ds-sidebar nav span { padding: 6px 8px 6px 15px; border-radius: 4px; color: #3d4654; font-size: 8px; }
  .ds-sidebar nav span.active { background: #dcecff; color: #1674d1; font-weight: 700; }
  .ds-story { min-width: 0; display: grid; grid-template-rows: 38px 1fr; background: white; }
  .ds-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 0 13px; border-bottom: 1px solid #dfe2e8; color: #525866; font-size: 7px; }
  .ds-toolbar div { display: flex; gap: 12px; }
  .ds-toolbar i { width: 10px; height: 10px; display: block; border: 1px solid #9aa1ad; border-radius: 2px; }
  .ds-story article { width: min(82%, 680px); padding: 30px 38px; }
  .ds-story article > small { color: #8b93a1; font-size: 7px; font-weight: 700; letter-spacing: .08em; }
  .ds-story h2 { margin: 8px 0 0; font-size: clamp(24px, 3.3vw, 39px); letter-spacing: -.04em; }
  .ds-story p { max-width: 560px; margin-top: 10px; color: #606775; font-size: 9px; line-height: 1.65; }
  .ds-story hr { margin: 24px 0 20px; border: 0; border-top: 1px solid #e2e4e9; }
  .ds-story h3 { font-size: 14px; }
  .ds-preview-row { display: flex; align-items: end; gap: 8px; margin-top: 14px; padding: 16px; border: 1px solid #e1e4e9; border-radius: 5px; background: #fbfbfc; }
  .ds-preview-row button { height: 29px; padding: 0 12px; border: 1px solid #0f172a; border-radius: 5px; background: #0f172a; color: #fff; font-size: 8px; }
  .ds-preview-row button.outline { background: #fff; color: #0f172a; }
  .ds-preview-row label { display: grid; gap: 4px; color: #525866; font-size: 7px; }
  .ds-preview-row input { width: 105px; height: 29px; padding: 0 8px; border: 1px solid #cfd3da; border-radius: 5px; background: #fff; color: #7b828d; font-size: 8px; }

  /* Intranet, based on the Flutter home dashboard, app shell and zinc tokens */
  .mock-intranet { display: grid; grid-template-columns: minmax(150px, .75fr) minmax(220px, 290px) minmax(170px, .9fr); gap: clamp(18px, 4vw, 52px); place-content: center; padding: 22px clamp(20px, 4vw, 48px); background: #050506; }
  .intranet-context { display: flex; flex-direction: column; justify-content: center; }
  .intranet-context > small, .intranet-sync > small { color: #71717a; font: 500 7px/1 $font-mono; letter-spacing: .1em; }
  .intranet-context > strong { max-width: 210px; margin-top: 14px; font-size: clamp(18px, 2.4vw, 30px); line-height: 1.15; letter-spacing: -.04em; }
  .intranet-context dl { display: grid; gap: 10px; margin-top: 28px; }
  .intranet-context dl div { display: flex; align-items: end; justify-content: space-between; gap: 12px; padding-top: 9px; border-top: 1px solid #27272a; }
  .intranet-context dt { font: 500 9px/1 $font-mono; }
  .intranet-context dd { color: #71717a; font-size: 8px; }
  .intranet-phone { width: 100%; height: 100%; min-height: 286px; display: grid; grid-template-rows: 22px 38px 1fr 42px; overflow: hidden; border: 3px solid #27272a; border-radius: 25px; background: #09090b; box-shadow: 0 26px 70px rgba(0,0,0,.55); }
  .intranet-status { display: flex; align-items: center; justify-content: space-between; padding: 5px 14px 0; font-size: 7px; }
  .intranet-status i { width: 18px; height: 5px; border-radius: 4px; background: #fafafa; }
  .intranet-phone > header { display: flex; align-items: center; justify-content: space-between; padding: 0 14px; border-bottom: 1px solid #27272a; }
  .intranet-phone > header strong { font-size: 13px; }
  .intranet-phone > header span { color: #71717a; font-size: 8px; }
  .intranet-phone > main { min-height: 0; padding: 12px; overflow: hidden; }
  .intranet-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .intranet-stats article { display: grid; gap: 3px; padding: 9px 7px; border: 1px solid #27272a; border-radius: 8px; background: #111114; }
  .intranet-stats article i { color: #a1a1aa; font-size: 9px; font-style: normal; }
  .intranet-stats article strong { font-size: 15px; }
  .intranet-stats article small { color: #71717a; font-size: 7px; }
  .intranet-calendar, .intranet-notice { margin-top: 10px; }
  .intranet-calendar > header, .intranet-notice > header { display: flex; align-items: center; justify-content: space-between; }
  .intranet-calendar > header strong, .intranet-notice > header strong { font-size: 9px; }
  .intranet-calendar > header span, .intranet-notice > header span { color: #71717a; font-size: 7px; }
  .intranet-notice > header span { color: #4ade80; font-family: $font-mono; }
  .week { display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 7px; border: 1px solid #27272a; border-radius: 7px; }
  .week span { display: grid; gap: 4px; place-items: center; padding: 6px 2px; color: #71717a; font-size: 6px; }
  .week span small { display: grid; width: 16px; height: 16px; place-items: center; border-radius: 50%; color: #a1a1aa; font-size: 7px; }
  .week span.today small { background: #fafafa; color: #09090b; }
  .intranet-calendar > p { display: grid; grid-template-columns: 4px 1fr; margin-top: 7px; padding: 7px 8px; border-radius: 7px; background: #18181b; }
  .intranet-calendar > p i { grid-row: 1 / 3; border-radius: 3px; background: #fafafa; }
  .intranet-calendar > p strong, .intranet-calendar > p small { margin-left: 7px; }
  .intranet-calendar > p strong { font-size: 8px; }
  .intranet-calendar > p small { margin-top: 3px; color: #71717a; font-size: 6px; }
  .intranet-notice > p { display: flex; justify-content: space-between; margin-top: 7px; padding: 8px; border: 1px solid #27272a; border-radius: 7px; font-size: 8px; }
  .intranet-notice > p small { color: #71717a; font-size: 6px; }
  .intranet-phone > footer { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #27272a; background: #111114; }
  .intranet-phone > footer span { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: #71717a; font-size: 6px; }
  .intranet-phone > footer span.active { color: #fafafa; }
  .intranet-phone > footer i { font-size: 10px; font-style: normal; }
  .intranet-phone > footer b { position: absolute; top: 6px; left: 54%; width: 5px; height: 5px; border-radius: 50%; background: #ef4444; }
  .intranet-sync { display: flex; flex-direction: column; justify-content: center; }
  .intranet-sync > div { display: grid; gap: 5px; margin-top: 14px; }
  .intranet-sync > div span { padding: 7px 9px; border-left: 1px solid #27272a; color: #52525b; font: 500 7px/1 $font-mono; }
  .intranet-sync > div span.active { border-left-color: #fafafa; color: #fafafa; }
  .intranet-sync article { display: grid; grid-template-columns: 7px 1fr; gap: 10px; margin-top: 14px; }
  .intranet-sync article > i { width: 7px; height: 7px; margin-top: 2px; border: 1px solid #71717a; border-radius: 50%; }
  .intranet-sync article p { display: grid; gap: 4px; }
  .intranet-sync article strong { font-size: 9px; }
  .intranet-sync article small { color: #71717a; font: 500 7px/1.4 $font-mono; }

  /* Boundra, based on the public brand, CLI diagnostics and Vite overlay */
  .mock-boundra { display: grid; grid-template-columns: minmax(225px, .72fr) minmax(0, 1.28fr); background: #07100c; font-family: $font-mono; }
  .boundra-intro { display: flex; flex-direction: column; justify-content: center; padding: clamp(22px, 4vw, 48px); border-right: 1px solid #264737; background: radial-gradient(circle at 10% 10%, rgba(200,237,107,.11), transparent 43%), #0b1711; }
  .boundra-intro > small { color: #83a992; font: 500 7px/1 $font-mono; letter-spacing: .1em; }
  .boundra-intro > strong { margin-top: 13px; color: #edf7f0; font-size: clamp(34px, 5vw, 70px); line-height: .88; letter-spacing: -.075em; }
  .boundra-intro > p { max-width: 300px; margin-top: 18px; color: #9fb0a5; font-size: 10px; line-height: 1.55; }
  .boundra-intro > div { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 24px; }
  .boundra-intro > div span { padding: 5px 6px; border: 1px solid #315c45; color: #c8ed6b; font-size: 7px; }
  .boundra-terminal { min-width: 0; display: grid; grid-template-rows: 44px 1fr; }
  .boundra-terminal > header { display: flex; align-items: center; justify-content: space-between; padding: 0 16px; border-bottom: 1px solid #264737; background: #0b1711; }
  .boundra-terminal > header div { display: flex; gap: 6px; }
  .boundra-terminal > header div span { width: 7px; height: 7px; border-radius: 50%; background: #315c45; }
  .boundra-terminal > header strong { font-size: 10px; }
  .boundra-terminal > header small { color: #83a992; font-size: 8px; }
  .boundra-terminal > main { display: flex; flex-direction: column; min-width: 0; padding: 22px; }
  .boundra-terminal > main > p { color: #d7e3db; font-size: 10px; }
  .boundra-terminal > main > p i { color: #c8ed6b; font-style: normal; }
  .boundra-terminal > main > p.muted { margin-top: 10px; color: #668374; font-size: 8px; }
  .diagnostic { margin-top: 20px; padding: 15px; border: 1px solid #315c45; background: #0b1711; }
  .diagnostic > div { display: flex; align-items: center; gap: 10px; }
  .diagnostic > div b { padding: 4px 6px; background: #c8ed6b; color: #07100c; font-size: 8px; }
  .diagnostic > div span { color: #c8ed6b; font-size: 8px; }
  .diagnostic > div em { margin-left: auto; color: #f87171; font-size: 8px; font-style: normal; }
  .diagnostic > strong { display: block; margin-top: 12px; color: #a8b8ad; font-size: 8px; }
  .diagnostic code { display: block; margin-top: 10px; padding: 8px; overflow: hidden; background: #07100c; color: #e6ece8; font-size: 8px; white-space: nowrap; }
  .diagnostic p { margin-top: 10px; color: #a8b8ad; font-size: 8px; }
  .diagnostic > small { display: block; margin-top: 10px; color: #c8ed6b; font-size: 7px; }
  .boundra-terminal main footer { display: flex; gap: 18px; margin-top: auto; padding-top: 12px; border-top: 1px solid #264737; color: #668374; font-size: 8px; }
  .boundra-terminal main footer strong { margin-left: auto; color: #c8ed6b; }

  /* OWKR Balance, reduced from the live operator dashboard and matchup table */
  .mock-owkr { display: grid; grid-template-rows: 42px 1fr; background: #0d0e12; color: #e2e8f0; }
  .owkr-app-header { display: flex; align-items: center; padding: 0 16px; border-bottom: 1px solid rgba(30,41,59,.55); background: rgba(13,14,18,.94); }
  .owkr-app-header > strong { background: linear-gradient(90deg, #60a5fa, #67e8f9); background-clip: text; color: transparent; font-size: 11px; }
  .owkr-app-header nav { display: flex; gap: 14px; margin-left: auto; }
  .owkr-app-header nav span { color: #64748b; font-size: 7px; font-weight: 600; }
  .owkr-app-header nav .scrim { color: #c4b5fd; }
  .owkr-app-header nav .sheet { color: #6ee7b7; }
  .owkr-app-header > small { margin-left: 14px; padding-left: 14px; border-left: 1px solid #1e293b; color: #475569; font-size: 7px; }
  .owkr-dashboard { display: grid; grid-template-columns: minmax(150px, 29%) minmax(0, 1fr); gap: 12px; min-height: 0; padding: 12px 14px; }
  .owkr-card { border: 1px solid rgba(30,41,59,.58); border-radius: 12px; background: #14161c; box-shadow: 0 8px 24px rgba(0,0,0,.16); }
  .owkr-sidebar { display: grid; grid-template-rows: auto 1fr; gap: 10px; min-height: 0; }
  .owkr-roster-summary { padding: 10px 11px; }
  .owkr-roster-summary > header, .owkr-player-list > header, .owkr-balance-summary > header, .owkr-result-head { display: flex; align-items: center; justify-content: space-between; }
  .owkr-roster-summary > header > div { display: flex; align-items: center; gap: 6px; }
  .owkr-roster-summary > header i { color: #67e8f9; font-size: 8px; font-style: normal; }
  .owkr-roster-summary > header strong { font-size: 8px; }
  .owkr-roster-summary > header b { padding: 4px 6px; border-radius: 999px; background: rgba(16,185,129,.12); color: #6ee7b7; font-size: 7px; }
  .owkr-roster-summary > p { margin-top: 7px; color: #475569; font-size: 6.5px; }
  .owkr-progress { height: 4px; margin-top: 10px; overflow: hidden; border-radius: 999px; background: #1e293b; }
  .owkr-progress i { display: block; width: 100%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #10b981, #22d3ee); }
  .owkr-roster-summary dl { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; margin-top: 8px; }
  .owkr-roster-summary dl > div { padding: 7px; border: 1px solid rgba(30,41,59,.5); border-radius: 8px; background: rgba(13,14,18,.55); }
  .owkr-roster-summary dt { color: #64748b; font-size: 6px; }
  .owkr-roster-summary dd { margin-top: 4px; font-size: 9px; font-weight: 700; }
  .owkr-roster-summary button { width: 100%; margin-top: 8px; padding: 7px; border: 0; border-radius: 7px; background: #4f73ed; color: white; font-size: 7px; font-weight: 700; box-shadow: 0 5px 14px rgba(59,130,246,.2); }
  .owkr-roster-summary button span { margin-left: 4px; }
  .owkr-player-list { display: flex; min-height: 0; flex-direction: column; padding: 9px; overflow: hidden; }
  .owkr-player-list > header strong { font-size: 7px; }
  .owkr-player-list > header small, .owkr-player-list > header span { color: #475569; font-size: 6px; font-weight: 500; }
  .owkr-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; margin-top: 8px; padding: 3px; border-radius: 8px; background: #0d0e12; }
  .owkr-tabs > * { padding: 6px; border-radius: 6px; color: #64748b; font-size: 6px; font-style: normal; text-align: center; }
  .owkr-tabs > b { background: #263043; color: #cbd5e1; }
  .owkr-tabs em { margin-left: 3px; color: #6ee7b7; font-size: 5px; font-style: normal; }
  .owkr-player-list ul { display: grid; min-height: 0; flex: 1; grid-template-rows: repeat(5,minmax(0,1fr)); gap: 4px; margin-top: 7px; list-style: none; }
  .owkr-player-list li { display: grid; gap: 3px; padding: 6px 7px; border: 1px solid rgba(30,41,59,.45); border-radius: 7px; background: #0f1116; }
  .owkr-player-list li strong { font-size: 6.5px; }
  .owkr-player-list li small { color: #64748b; font-size: 5.5px; }
  .owkr-result { display: grid; grid-template-rows: 26px auto 24px 17px 1fr; gap: 6px; min-width: 0; min-height: 0; }
  .owkr-result-head > strong { font-size: 9px; }
  .owkr-result-head > div { display: flex; gap: 4px; }
  .owkr-result-head span, .owkr-result-head b { padding: 5px 7px; border: 1px solid #293244; border-radius: 6px; color: #64748b; font-size: 6px; font-weight: 600; }
  .owkr-result-head b { border-color: #4f73ed; background: #4f73ed; color: white; box-shadow: 0 4px 12px rgba(59,130,246,.18); }
  .owkr-balance-summary { padding: 8px 10px; }
  .owkr-balance-summary > header strong { font-size: 7px; }
  .owkr-balance-summary > header small { color: #64748b; font-size: 5.5px; }
  .owkr-balance-summary dl { display: grid; grid-template-columns: repeat(4,1fr); gap: 5px; margin-top: 7px; }
  .owkr-balance-summary dl > div { padding: 6px 7px; border-radius: 7px; background: #0f1116; }
  .owkr-balance-summary dl > div.total { border: 1px solid rgba(34,211,238,.14); background: rgba(34,211,238,.04); }
  .owkr-balance-summary dt { color: #64748b; font-size: 5px; }
  .owkr-balance-summary dd { margin-top: 3px; color: #fda4af; font: 700 7px/1 $font-mono; }
  .owkr-balance-summary .total dd, .owkr-balance-summary dd.blue { color: #93c5fd; }
  .owkr-exceptions { display: flex; gap: 4px; margin-top: 6px; }
  .owkr-exceptions span { padding: 3px 5px; border: 1px solid rgba(245,158,11,.2); border-radius: 999px; background: rgba(245,158,11,.07); color: #fbbf24; font-size: 5px; }
  .owkr-exceptions b { font-weight: 700; }
  .owkr-swap-guide { display: flex; align-items: center; padding: 0 8px; border: 1px solid rgba(30,41,59,.55); border-radius: 7px; background: rgba(20,22,28,.7); color: #64748b; font-size: 5.5px; }
  .owkr-rank-toggle { display: flex; align-items: center; justify-content: flex-end; gap: 5px; color: #64748b; font-size: 5.5px; }
  .owkr-rank-toggle > i { width: 18px; height: 9px; padding: 1px; border-radius: 999px; background: #334155; }
  .owkr-rank-toggle b { display: block; width: 7px; height: 7px; border-radius: 50%; background: #64748b; }
  .owkr-matchup { display: grid; min-height: 0; grid-template-rows: auto repeat(5,minmax(26px,1fr)); overflow: hidden; }
  .owkr-matchup > header { display: grid; grid-template-columns: 1fr 1fr; padding: 0 7px 5px; }
  .owkr-matchup > header > div { display: flex; align-items: center; gap: 5px; }
  .owkr-matchup > header > div:last-child { justify-content: flex-end; }
  .owkr-matchup > header strong { font-size: 9px; }
  .owkr-matchup > header > div:first-child strong { color: #60a5fa; }
  .owkr-matchup > header > div:last-child strong { color: #fb7185; }
  .owkr-matchup > header span { padding: 3px 4px; border-radius: 4px; background: rgba(249,115,22,.15); color: #fdba74; font-size: 5px; }
  .owkr-matchup > header > div:last-child span { background: rgba(16,185,129,.14); color: #6ee7b7; }
  .owkr-match-row { display: grid; grid-template-columns: minmax(0,1fr) 22px minmax(0,1fr); min-height: 26px; align-items: center; margin-top: 4px; border: 1px solid rgba(51,65,85,.7); border-radius: 7px; background: rgba(2,6,23,.18); }
  .owkr-match-row .player { display: flex; min-width: 0; align-items: center; gap: 4px; padding: 0 7px; }
  .owkr-match-row .player.left { justify-content: flex-end; }
  .owkr-match-row .player.right { justify-content: flex-start; }
  .owkr-match-row .player strong { overflow: hidden; font-size: 6.5px; text-overflow: ellipsis; white-space: nowrap; }
  .owkr-match-row .player small { color: #94a3b8; font: 500 5.5px/1 $font-mono; white-space: nowrap; }
  .owkr-match-row .player i { color: #facc15; font-size: 6px; font-style: normal; }
  .owkr-role { display: grid; width: 22px; height: 100%; place-items: center; color: #64748b; }
  .owkr-role svg { width: 10px; height: 10px; fill: currentColor; }

  /* Jeomjuro consumer home using the original product assets and proportions */
  .mock-jeomjuro { display: grid; grid-template-rows: minmax(0,1fr) 86px; background: #fff; color: #13243a; font-family: 'Pretendard', sans-serif; }
  .jeomjuro-consumer-surface { min-height: 0; display: grid; grid-template-rows: 54px 38px 1fr; overflow: hidden; background: #fff; }
  .jeomjuro-consumer-header { display: flex; min-width: 0; align-items: center; gap: 30px; padding: 0 28px; background: #fff; }
  .jeomjuro-logo { display: flex; flex: 0 0 auto; align-items: center; gap: 6px; }
  .jeomjuro-logo img:first-child { width: 28px; height: 28px; object-fit: contain; }
  .jeomjuro-logo img:last-child { width: 64px; height: auto; object-fit: contain; }
  .jeomjuro-search { height: 30px; display: flex; min-width: 0; flex: 1; align-items: center; justify-content: space-between; padding: 0 10px; border: 1px solid #9dd8fb; border-radius: 5px; background: #fff; color: #a0a7af; font-size: 7.5px; }
  .jeomjuro-search svg, .jeomjuro-bell svg, .jeomjuro-nav svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.7; }
  .jeomjuro-search svg { width: 14px; color: #67bdf1; }
  .jeomjuro-bell { display: grid; width: 26px; height: 26px; flex: 0 0 auto; margin-left: 38px; place-items: center; color: #111827; }
  .jeomjuro-bell svg { width: 14px; }
  .jeomjuro-nav { display: flex; align-items: center; gap: 42px; padding: 0 28px; border-bottom: 1px solid #e4e7eb; background: #fff; }
  .jeomjuro-nav span { display: inline-flex; align-items: center; gap: 6px; color: #111827; font-size: 8px; font-weight: 700; }
  .jeomjuro-nav span.active { color: #1d99eb; }
  .jeomjuro-nav svg { width: 10px; }
  .jeomjuro-consumer-main { min-width: 0; overflow: hidden; padding: 12px 28px 16px; background: #fff; }
  .jeomjuro-top { height: 96px; display: grid; grid-template-columns: minmax(0,2.07fr) minmax(150px,1fr); gap: 10px; }
  .jeomjuro-banner { width: 100%; height: 96px; display: block; border: 1px solid #d3d9e0; border-radius: 7px; object-fit: cover; }
  .jeomjuro-profile { display: flex; height: 96px; align-items: center; justify-content: space-between; padding: 14px; border: 1px solid #d3d9e0; border-radius: 7px; background: #fff; }
  .jeomjuro-profile > div { display: flex; align-items: center; gap: 9px; }
  .jeomjuro-profile > div > i { width: 31px; height: 31px; flex: 0 0 auto; border-radius: 50%; background: #eef0f2; }
  .jeomjuro-profile span { display: grid; gap: 4px; }
  .jeomjuro-profile strong { font-size: 8px; }
  .jeomjuro-profile small { color: #4ec3ff; font-size: 6px; font-weight: 600; }
  .jeomjuro-profile button { padding: 4px 8px; border: 1px solid #9dd8fb; border-radius: 4px; background: #f2fbff; color: #1d99eb; font-size: 5.5px; font-weight: 700; }
  .jeomjuro-interest { margin-top: 13px; }
  .jeomjuro-interest h2, .jeomjuro-hot > header strong { margin: 0 0 7px; color: #111827; font-size: 8px; font-weight: 700; }
  .jeomjuro-interest > div { height: 58px; display: flex; align-items: center; gap: 24px; padding: 7px 12px; border: 1px solid #d3d9e0; border-radius: 6px; background: #fff; }
  .jeomjuro-interest > div > span { display: grid; justify-items: center; gap: 3px; }
  .jeomjuro-interest i { width: 30px; height: 30px; border: 1px solid #d9e1e8; border-radius: 50%; background: #f1f3f5; }
  .jeomjuro-interest span:nth-child(2) i { background: #eff8fe; }
  .jeomjuro-interest span:nth-child(3) i { background: #f1f8ed; }
  .jeomjuro-interest span:nth-child(4) i { background: #fff5e9; }
  .jeomjuro-interest small { color: #13243a; font-size: 5.5px; font-weight: 600; }
  .jeomjuro-feed { display: grid; grid-template-columns: minmax(0,2.07fr) minmax(150px,1fr); gap: 10px; margin-top: 13px; }
  .jeomjuro-hot { min-width: 0; }
  .jeomjuro-hot > div { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
  .jeomjuro-hot article { min-width: 0; height: 74px; display: flex; flex-direction: column; padding: 8px; border: 1px solid #d3d9e0; border-radius: 6px; background: #fff; }
  .jeomjuro-hot article > b { width: fit-content; padding: 2px 6px; border-radius: 999px; background: #e50624; color: #fff; font-size: 4.5px; }
  .jeomjuro-hot article > strong { margin-top: 5px; overflow: hidden; font-size: 6px; text-overflow: ellipsis; white-space: nowrap; }
  .jeomjuro-hot article p { margin-top: 4px; overflow: hidden; color: #526274; font-size: 5px; text-overflow: ellipsis; white-space: nowrap; }
  .jeomjuro-hot article small { margin-top: auto; color: #7f8b98; font-size: 4px; }
  .jeomjuro-best { height: 101px; overflow: hidden; border: 1px solid #d3d9e0; border-radius: 6px; background: #fff; }
  .jeomjuro-best header { padding: 9px 12px 7px; }
  .jeomjuro-best header strong { font-size: 8px; }
  .jeomjuro-best nav { height: 22px; display: grid; grid-template-columns: 1fr 1fr; border-block: 1px solid #d3d9e0; }
  .jeomjuro-best nav > * { display: grid; place-items: center; font-size: 5.5px; }
  .jeomjuro-best nav b { border-right: 1px solid #d3d9e0; color: #1d99eb; }
  .jeomjuro-best nav span { color: #7f8b98; font-weight: 700; }
  .jeomjuro-best > div { display: grid; grid-template-columns: 18px 1fr; gap: 4px; padding: 4px 10px 1px; }
  .jeomjuro-best > div b, .jeomjuro-best > div span { overflow: hidden; font-size: 5px; text-overflow: ellipsis; white-space: nowrap; }
  .jeomjuro-best > div b { font-family: $font-mono; }
  .jeomjuro-subsystems { min-height: 0; display: grid; grid-template-columns: 1.15fr 1.15fr .7fr; border-top: 1px solid #d9e1e8; background: #f8fafc; }
  .jeomjuro-subsystems > section, .jeomjuro-subsystems > footer { min-width: 0; padding: 11px 14px; border-right: 1px solid #d9e1e8; }
  .jeomjuro-subsystems header { display: flex; align-items: baseline; gap: 9px; }
  .jeomjuro-subsystems header span, .jeomjuro-subsystems > footer small { color: #1d99eb; font: 600 5px/1 $font-mono; }
  .jeomjuro-subsystems header b { font-size: 7px; }
  .jeomjuro-admin > div, .jeomjuro-ds > div { height: 34px; display: flex; align-items: center; gap: 7px; margin-top: 7px; padding: 5px 7px; border: 1px solid #d9e1e8; border-radius: 5px; background: #fff; }
  .jeomjuro-admin img { width: 31px; height: auto; }
  .jeomjuro-admin i { width: 48px; height: 10px; border: 1px solid #d3d9e0; border-radius: 3px; background: #f5f7f9; }
  .jeomjuro-admin button, .jeomjuro-ds button { height: 15px; padding: 0 7px; border: 1px solid #1d99eb; border-radius: 3px; background: #1d99eb; color: #fff; font-size: 4.5px; }
  .jeomjuro-ds button.outline { background: #fff; color: #1d99eb; }
  .jeomjuro-ds label { width: 64px; height: 15px; display: flex; align-items: center; padding: 0 5px; border: 1px solid #d3d9e0; border-radius: 3px; color: #7f8b98; font-size: 4.5px; }
  .jeomjuro-subsystems > footer { display: flex; flex-direction: column; justify-content: center; gap: 6px; border-right: 0; }
  .jeomjuro-subsystems > footer b { color: #13243a; font: 600 7px/1 $font-mono; }
  .jeomjuro-subsystems > footer span { color: #7f8b98; font-size: 5px; }

  /* Marker, matched to the mobile Kakao map shell, filters and Vaul peek sheet */
  .mock-marker { background: #e8eef1; color: #292d32; }
  .map-grid { position: absolute; inset: 0; opacity: .7; background-color: #e8eeed; background-image: linear-gradient(28deg, transparent 47%, #cbd4d5 48%, #cbd4d5 50%, transparent 51%), linear-gradient(107deg, transparent 47%, #d0d8d8 48%, #d0d8d8 50%, transparent 51%), radial-gradient(circle at 18% 44%, #dce9d4 0 13%, transparent 14%); background-size: 105px 76px, 138px 92px, 100% 100%; }
  .mock-marker > header { position: relative; z-index: 5; height: 56px; display: flex; align-items: center; padding: 0 16px; background: rgba(255,255,255,.96); box-shadow: 0 1px 16px rgba(0,0,0,.06); }
  .mock-marker > header img { width: 72px; height: 42px; object-fit: contain; object-position: left center; }
  .mock-marker > header button { margin-left: auto; padding: 7px 13px; border: 0; border-radius: 999px; background: #ff5e8c; color: white; font-size: 8px; font-weight: 700; box-shadow: 0 4px 12px rgba(255,94,140,.28); }
  .marker-filters { position: relative; z-index: 4; height: 43px; display: flex; align-items: center; padding: 0 12px; background: rgba(255,255,255,.96); box-shadow: 0 2px 10px rgba(0,0,0,.06); }
  .marker-filters > div { display: flex; min-width: 0; gap: 5px; overflow: hidden; }
  .marker-filters span, .marker-filters > b { flex: 0 0 auto; padding: 6px 9px; border-radius: 999px; background: #f3f4f6; color: #6b7280; font-size: 7px; font-weight: 700; }
  .marker-filters span.active { background: #ff5e8c; color: white; }
  .marker-filters > b { margin-left: auto; border-radius: 8px; background: #fff; color: #ff5e8c; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .marker-road { position: absolute; z-index: 1; height: 16px; background: #fff; border: 1px solid #d9e0e2; transform-origin: center; }
  .marker-road::after { content: ''; position: absolute; inset: 7px 0 auto; border-top: 1px dashed #bbc5c8; }
  .marker-road.road-a { width: 82%; top: 48%; left: -9%; transform: rotate(-17deg); }
  .marker-road.road-b { width: 66%; top: 37%; right: -13%; transform: rotate(43deg); }
  .marker-river { position: absolute; z-index: 0; top: 95px; bottom: 0; left: 55%; width: 145px; background: rgba(167,213,230,.48); transform: rotate(15deg); }
  .current-location { position: absolute; z-index: 3; top: 47%; left: 48%; width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; background: rgba(59,130,246,.18); }
  .current-location i { width: 8px; height: 8px; border: 2px solid white; border-radius: 50%; background: #3b82f6; box-shadow: 0 1px 5px rgba(37,99,235,.45); }
  .pin { position: absolute; z-index: 2; display: grid; width: 30px; height: 36px; place-items: center; border: 3px solid white; border-radius: 50% 50% 50% 7px; transform: rotate(-45deg); box-shadow: 0 4px 12px rgba(0,0,0,.18); }
  .pin span { transform: rotate(45deg); font-size: 10px; }
  .pin-a { top: 132px; left: 25%; background: #ff6b6b; }
  .pin-b { top: 167px; left: 68%; background: #4ecdc4; }
  .pin-c { top: 112px; left: 79%; background: #6c5ce7; }
  .place-sheet { position: absolute; z-index: 6; right: 0; bottom: 0; left: 0; min-height: 118px; padding: 11px 18px 16px; border-radius: 24px 24px 0 0; background: white; box-shadow: 0 -8px 30px rgba(0,0,0,.1); }
  .place-sheet > i { display: block; width: 38px; height: 4px; margin: 0 auto 8px; border-radius: 3px; background: #e5e7eb; }
  .place-sheet h3 { margin: 0; color: #374151; font-size: 9px; }
  .top-place-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
  .top-place-list article { display: flex; align-items: center; gap: 8px; padding: 8px; border-left: 3px solid #ff6b6b; border-radius: 11px; background: #fff5f5; }
  .top-place-list article + article { border-left-color: #4ecdc4; background: #f0fcfb; }
  .top-place-list article > b { width: 28px; height: 28px; display: grid; flex: 0 0 auto; place-items: center; border-radius: 50%; background: #ff6b6b; font-size: 10px; }
  .top-place-list article > b.mint { background: #4ecdc4; }
  .top-place-list article p { min-width: 0; display: grid; gap: 3px; }
  .top-place-list article strong { overflow: hidden; color: #292d32; font-size: 7px; text-overflow: ellipsis; white-space: nowrap; }
  .top-place-list article small { color: #ff6b6b; font-size: 6px; font-weight: 700; }
  .top-place-list article em { margin-left: auto; color: #ff6b6b; font-size: 7px; font-style: normal; font-weight: 700; }

  /* Rust with TypeScript, matched to the actual bright Starlight landing page */
  .mock-rust { display: grid; grid-template-rows: 50px 1fr; background: #fff; color: #11131a; }
  .mock-rust > header { display: flex; align-items: center; padding: 0 22px; border-bottom: 1px solid #e5e7eb; background: rgba(255,255,255,.96); }
  .mock-rust > header strong { font-size: 12px; letter-spacing: -.025em; }
  .mock-rust > header strong span { color: #e74f3b; }
  .mock-rust > header strong b { color: #3178c6; }
  .rust-tools { display: flex; align-items: center; gap: 13px; margin-left: auto; color: #4b5563; }
  .rust-tools > span { min-width: 160px; display: flex; align-items: center; padding: 7px 9px; border: 1px solid #dfe3e8; border-radius: 7px; color: #7a808b; font-size: 7px; }
  .rust-tools kbd { margin-left: auto; padding: 2px 4px; border-radius: 3px; background: #eef0f3; font-size: 6px; }
  .rust-tools i { font-style: normal; font-size: 11px; }
  .rust-tools small { font-size: 7px; }
  .mock-rust > main { min-width: 0; padding: 27px clamp(22px, 7vw, 84px) 22px; }
  .rust-hero h2 { margin: 0; color: #121318; font-size: clamp(31px, 5vw, 58px); line-height: 1; letter-spacing: -.065em; }
  .rust-hero > p { margin-top: 13px; color: #343842; font-size: clamp(11px, 1.45vw, 16px); font-weight: 600; }
  .rust-hero > div { display: flex; align-items: center; gap: 18px; margin-top: 18px; }
  .rust-hero button { padding: 9px 15px; border: 0; border-radius: 999px; background: #e94834; color: #fff; font-size: 8px; font-weight: 700; }
  .rust-hero button span { margin-left: 8px; }
  .rust-hero a { color: #343842; font-size: 8px; font-weight: 700; }
  .code-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 24px; }
  .code-compare section { min-width: 0; overflow: hidden; border: 1px solid #e0e3e8; border-radius: 8px; background: #fbfbfc; box-shadow: 0 4px 18px rgba(20,24,32,.04); }
  .code-compare header { padding: 9px 12px; border-bottom: 1px solid #e0e3e8; color: #4b5563; font: 600 8px/1 $font-mono; }
  .code-compare code { display: block; padding: 13px; overflow: hidden; color: #454b55; font: 400 8px/1.75 $font-mono; white-space: nowrap; }
  .code-compare code i { color: #b53b80; font-style: normal; }
  .code-compare code b { color: #26734d; font-weight: 400; }

  /* Kivra, matched to the actual Tauri desktop app shell and Runs tab */
  .mock-kivra { display: grid; grid-template-columns: 160px 1fr; background: hsl(220 14% 7%); color: hsl(220 12% 92%); }
  .kivra-sidebar { display: flex; min-height: 0; flex-direction: column; border-right: 1px solid hsl(220 10% 18%); background: hsl(220 13% 9%); }
  .kivra-sidebar > header { display: flex; height: 48px; align-items: center; gap: 8px; padding: 0 12px; border-bottom: 1px solid hsl(220 10% 18%); }
  .kivra-sidebar > header > span { width: 24px; height: 24px; display: grid; place-items: center; border: 1px solid hsl(220 10% 24%); border-radius: 6px; background: #f1f1f2; color: #111216; font-size: 11px; font-weight: 800; }
  .kivra-sidebar > header div { display: grid; gap: 2px; }
  .kivra-sidebar > header strong { font-size: 10px; }
  .kivra-sidebar > header small { color: hsl(220 8% 58%); font-size: 6px; }
  .kivra-sidebar nav { display: grid; gap: 3px; padding: 9px 7px; }
  .kivra-sidebar nav > * { padding: 7px 8px; border-radius: 5px; color: hsl(220 8% 62%); font-size: 8px; font-weight: 500; }
  .kivra-sidebar nav > .active, .kivra-sidebar nav > b { background: hsl(220 12% 13%); color: hsl(220 12% 92%); }
  .kivra-sidebar > footer { display: flex; align-items: center; gap: 7px; margin-top: auto; padding: 9px; border-top: 1px solid hsl(220 10% 18%); }
  .kivra-sidebar > footer i { width: 22px; height: 22px; display: grid; place-items: center; border: 1px solid hsl(220 10% 18%); border-radius: 5px; color: hsl(220 8% 62%); font-size: 6px; font-style: normal; }
  .kivra-sidebar > footer strong { overflow: hidden; font-size: 7px; text-overflow: ellipsis; }
  .kivra-sidebar > footer span { margin-left: auto; color: hsl(220 8% 58%); }
  .kivra-project { min-width: 0; display: grid; grid-template-rows: 110px 1fr; }
  .kivra-project > header { padding: 10px 13px; border-bottom: 1px solid hsl(220 10% 18%); background: hsl(220 13% 9%); }
  .kivra-project > header > div:first-child { display: inline-grid; }
  .kivra-title strong { font-size: 12px; }
  .kivra-title small { margin-top: 3px; color: hsl(220 8% 58%); font: 500 6px/1 $font-mono; }
  .kivra-meta { float: right; display: flex; gap: 5px; }
  .kivra-meta > span { min-width: 62px; display: grid; gap: 4px; padding: 6px 7px; border: 1px solid hsl(220 10% 18%); border-radius: 5px; background: hsl(220 14% 7%); font: 500 6px/1 $font-mono; }
  .kivra-meta small { color: hsl(220 8% 58%); font-size: 5px; }
  .kivra-project > header nav { display: flex; align-items: center; gap: 2px; clear: both; margin-top: 12px; }
  .kivra-project > header nav b { padding: 6px 8px; border-radius: 4px; color: hsl(220 8% 58%); font-size: 6px; font-weight: 500; }
  .kivra-project > header nav b.active { background: hsl(220 12% 13%); color: hsl(220 12% 92%); }
  .kivra-project > header nav button { margin-left: auto; padding: 6px 9px; border: 0; border-radius: 5px; background: #f4f4f5; color: #111216; font-size: 6px; font-weight: 700; }
  .kivra-workspace { min-height: 0; display: grid; grid-template-columns: 175px 1fr; gap: 9px; padding: 9px; }
  .kivra-workspace > aside, .kivra-log { min-height: 0; overflow: hidden; border: 1px solid hsl(220 10% 18%); border-radius: 6px; background: hsl(220 13% 9%); }
