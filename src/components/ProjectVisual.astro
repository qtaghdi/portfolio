  .owkr-balance-summary dt { color: #64748b; font-size: 5px; }
  .owkr-balance-summary dd { margin-top: 3px; color: #fda4af; font: 700 7px/1 $font-mono; }
  .owkr-balance-summary .total dd, .owkr-balance-summary dd.blue { color: #93c5fd; }
  .owkr-exceptions { display: flex; gap: 4px; margin-top: 6px; }
  .owkr-exceptions span { padding: 3px 5px; border: 1px solid rgba(245,158,11,.2); border-radius: 999px; background: rgba(245,158,11,.07); color: #fbbf24; font-size: 5px; }
  .owkr-exceptions b { font-weight: 700; }
  .owkr-swap-guide { display: flex; align-items: center; padding: 0 8px; border: 1px solid rgba(30,41,59,.55); border-radius: 7px; background: rgba(20,22,28,.7); color: #64748b; font-size: 5.5px; }
  .owkr-rank-toggle { display: flex; align-items: center; justify-content: flex-end; gap: 5px; color: #64748b; font-size: 5.5px; }
  .owkr-rank-toggle > i { width: 18px; height: 9px; padding: 1px; border-radius: 999px; background: #334155; }
  .owkr-rank-toggle b { display: block; width: 7px; height: 7px; border-radius: 50%; background: #64748b; }
  .owkr-matchup { display: grid; min-height: 0; grid-template-rows: auto repeat(5,minmax(26px,1fr)); overflow: hidden; }
  .owkr-matchup > header { display: grid; grid-template-columns: 1fr 1fr; padding: 0 7px 5px; }
  .owkr-matchup > header > div { display: flex; align-items: center; gap: 5px; }
  .owkr-matchup > header > div:last-child { justify-content: flex-end; }
  .owkr-matchup > header strong { font-size: 9px; }
  .owkr-matchup > header > div:first-child strong { color: #60a5fa; }
  .owkr-matchup > header > div:last-child strong { color: #fb7185; }
  .owkr-matchup > header span { padding: 3px 4px; border-radius: 4px; background: rgba(249,115,22,.15); color: #fdba74; font-size: 5px; }
  .owkr-matchup > header > div:last-child span { background: rgba(16,185,129,.14); color: #6ee7b7; }
  .owkr-match-row { display: grid; grid-template-columns: minmax(0,1fr) 22px minmax(0,1fr); min-height: 26px; align-items: center; margin-top: 4px; border: 1px solid rgba(51,65,85,.7); border-radius: 7px; background: rgba(2,6,23,.18); }
  .owkr-match-row .player { display: flex; min-width: 0; align-items: center; gap: 4px; padding: 0 7px; }
  .owkr-match-row .player.left { justify-content: flex-end; }
  .owkr-match-row .player.right { justify-content: flex-start; }
  .owkr-match-row .player strong { overflow: hidden; font-size: 6.5px; text-overflow: ellipsis; white-space: nowrap; }
  .owkr-match-row .player small { color: #94a3b8; font: 500 5.5px/1 $font-mono; white-space: nowrap; }
  .owkr-match-row .player i { color: #facc15; font-size: 6px; font-style: normal; }
  .owkr-role { display: grid; width: 22px; height: 100%; place-items: center; color: #64748b; }
  .owkr-role svg { width: 10px; height: 10px; fill: currentColor; }

  /* Jeomjuro consumer home using the original product assets and proportions */
  .mock-jeomjuro { display: grid; grid-template-rows: minmax(0,1fr) 86px; background: #fff; color: #13243a; font-family: 'Pretendard', sans-serif; }
  .jeomjuro-consumer-surface { min-height: 0; display: grid; grid-template-rows: 54px 38px 1fr; overflow: hidden; background: #fff; }
  .jeomjuro-consumer-header { display: flex; min-width: 0; align-items: center; gap: 30px; padding: 0 28px; background: #fff; }
  .jeomjuro-logo { display: flex; flex: 0 0 auto; align-items: center; gap: 6px; }
  .jeomjuro-logo img:first-child { width: 28px; height: 28px; object-fit: contain; }
  .jeomjuro-logo img:last-child { width: 64px; height: auto; object-fit: contain; }
  .jeomjuro-search { height: 30px; display: flex; min-width: 0; flex: 1; align-items: center; justify-content: space-between; padding: 0 10px; border: 1px solid #9dd8fb; border-radius: 5px; background: #fff; color: #a0a7af; font-size: 7.5px; }
  .jeomjuro-search svg, .jeomjuro-bell svg, .jeomjuro-nav svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.7; }
  .jeomjuro-search svg { width: 14px; color: #67bdf1; }
  .jeomjuro-bell { display: grid; width: 26px; height: 26px; flex: 0 0 auto; margin-left: 38px; place-items: center; color: #111827; }
  .jeomjuro-bell svg { width: 14px; }
  .jeomjuro-nav { display: flex; align-items: center; gap: 42px; padding: 0 28px; border-bottom: 1px solid #e4e7eb; background: #fff; }
  .jeomjuro-nav span { display: inline-flex; align-items: center; gap: 6px; color: #111827; font-size: 8px; font-weight: 700; }
  .jeomjuro-nav span.active { color: #1d99eb; }
  .jeomjuro-nav svg { width: 10px; }
  .jeomjuro-consumer-main { min-width: 0; overflow: hidden; padding: 12px 28px 16px; background: #fff; }
  .jeomjuro-top { height: 96px; display: grid; grid-template-columns: minmax(0,2.07fr) minmax(150px,1fr); gap: 10px; }
  .jeomjuro-banner { width: 100%; height: 96px; display: block; border: 1px solid #d3d9e0; border-radius: 7px; object-fit: cover; }
  .jeomjuro-profile { display: flex; height: 96px; align-items: center; justify-content: space-between; padding: 14px; border: 1px solid #d3d9e0; border-radius: 7px; background: #fff; }
  .jeomjuro-profile > div { display: flex; align-items: center; gap: 9px; }
  .jeomjuro-profile > div > i { width: 31px; height: 31px; flex: 0 0 auto; border-radius: 50%; background: #eef0f2; }
  .jeomjuro-profile span { display: grid; gap: 4px; }
  .jeomjuro-profile strong { font-size: 8px; }
  .jeomjuro-profile small { color: #4ec3ff; font-size: 6px; font-weight: 600; }
  .jeomjuro-profile button { padding: 4px 8px; border: 1px solid #9dd8fb; border-radius: 4px; background: #f2fbff; color: #1d99eb; font-size: 5.5px; font-weight: 700; }
  .jeomjuro-interest { margin-top: 13px; }
  .jeomjuro-interest h2, .jeomjuro-hot > header strong { margin: 0 0 7px; color: #111827; font-size: 8px; font-weight: 700; }
  .jeomjuro-interest > div { height: 58px; display: flex; align-items: center; gap: 24px; padding: 7px 12px; border: 1px solid #d3d9e0; border-radius: 6px; background: #fff; }
  .jeomjuro-interest > div > span { display: grid; justify-items: center; gap: 3px; }
  .jeomjuro-interest i { width: 30px; height: 30px; border: 1px solid #d9e1e8; border-radius: 50%; background: #f1f3f5; }
  .jeomjuro-interest span:nth-child(2) i { background: #eff8fe; }
  .jeomjuro-interest span:nth-child(3) i { background: #f1f8ed; }
  .jeomjuro-interest span:nth-child(4) i { background: #fff5e9; }
  .jeomjuro-interest small { color: #13243a; font-size: 5.5px; font-weight: 600; }
  .jeomjuro-feed { display: grid; grid-template-columns: minmax(0,2.07fr) minmax(150px,1fr); gap: 10px; margin-top: 13px; }
  .jeomjuro-hot { min-width: 0; }
  .jeomjuro-hot > div { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
  .jeomjuro-hot article { min-width: 0; height: 74px; display: flex; flex-direction: column; padding: 8px; border: 1px solid #d3d9e0; border-radius: 6px; background: #fff; }
  .jeomjuro-hot article > b { width: fit-content; padding: 2px 6px; border-radius: 999px; background: #e50624; color: #fff; font-size: 4.5px; }
  .jeomjuro-hot article > strong { margin-top: 5px; overflow: hidden; font-size: 6px; text-overflow: ellipsis; white-space: nowrap; }
  .jeomjuro-hot article p { margin-top: 4px; overflow: hidden; color: #526274; font-size: 5px; text-overflow: ellipsis; white-space: nowrap; }
  .jeomjuro-hot article small { margin-top: auto; color: #7f8b98; font-size: 4px; }
  .jeomjuro-best { height: 101px; overflow: hidden; border: 1px solid #d3d9e0; border-radius: 6px; background: #fff; }
  .jeomjuro-best header { padding: 9px 12px 7px; }
  .jeomjuro-best header strong { font-size: 8px; }
  .jeomjuro-best nav { height: 22px; display: grid; grid-template-columns: 1fr 1fr; border-block: 1px solid #d3d9e0; }
  .jeomjuro-best nav > * { display: grid; place-items: center; font-size: 5.5px; }
  .jeomjuro-best nav b { border-right: 1px solid #d3d9e0; color: #1d99eb; }
  .jeomjuro-best nav span { color: #7f8b98; font-weight: 700; }
  .jeomjuro-best > div { display: grid; grid-template-columns: 18px 1fr; gap: 4px; padding: 4px 10px 1px; }
  .jeomjuro-best > div b, .jeomjuro-best > div span { overflow: hidden; font-size: 5px; text-overflow: ellipsis; white-space: nowrap; }
  .jeomjuro-best > div b { font-family: $font-mono; }
  .jeomjuro-subsystems { min-height: 0; display: grid; grid-template-columns: 1.15fr 1.15fr .7fr; border-top: 1px solid #d9e1e8; background: #f8fafc; }
  .jeomjuro-subsystems > section, .jeomjuro-subsystems > footer { min-width: 0; padding: 11px 14px; border-right: 1px solid #d9e1e8; }
  .jeomjuro-subsystems header { display: flex; align-items: baseline; gap: 9px; }
  .jeomjuro-subsystems header span, .jeomjuro-subsystems > footer small { color: #1d99eb; font: 600 5px/1 $font-mono; }
  .jeomjuro-subsystems header b { font-size: 7px; }
  .jeomjuro-admin > div, .jeomjuro-ds > div { height: 34px; display: flex; align-items: center; gap: 7px; margin-top: 7px; padding: 5px 7px; border: 1px solid #d9e1e8; border-radius: 5px; background: #fff; }
  .jeomjuro-admin img { width: 31px; height: auto; }
  .jeomjuro-admin i { width: 48px; height: 10px; border: 1px solid #d3d9e0; border-radius: 3px; background: #f5f7f9; }
  .jeomjuro-admin button, .jeomjuro-ds button { height: 15px; padding: 0 7px; border: 1px solid #1d99eb; border-radius: 3px; background: #1d99eb; color: #fff; font-size: 4.5px; }
  .jeomjuro-ds button.outline { background: #fff; color: #1d99eb; }
  .jeomjuro-ds label { width: 64px; height: 15px; display: flex; align-items: center; padding: 0 5px; border: 1px solid #d3d9e0; border-radius: 3px; color: #7f8b98; font-size: 4.5px; }
  .jeomjuro-subsystems > footer { display: flex; flex-direction: column; justify-content: center; gap: 6px; border-right: 0; }
  .jeomjuro-subsystems > footer b { color: #13243a; font: 600 7px/1 $font-mono; }
  .jeomjuro-subsystems > footer span { color: #7f8b98; font-size: 5px; }

  /* Marker, based on the Kakao map flow, emotion tokens and bottom sheet */
  .mock-marker { background: #e9eef1; color: #292d32; }
  .map-grid { position: absolute; inset: 0; opacity: .55; background-image: linear-gradient(28deg, transparent 46%, #c6ced2 47%, #c6ced2 49%, transparent 50%), linear-gradient(108deg, transparent 46%, #d0d7da 47%, #d0d7da 49%, transparent 50%); background-size: 90px 70px, 120px 80px; }
  .mock-marker > header { position: relative; z-index: 2; height: 48px; display: flex; align-items: center; gap: 20px; padding: 0 16px; background: rgba(255,255,255,.94); box-shadow: 0 2px 12px rgba(37,55,62,.08); }
  .mock-marker > header strong { color: #ff6b91; }
  .mock-marker > header div { display: flex; gap: 7px; }
  .mock-marker > header div span { padding: 5px 9px; border-radius: 999px; background: #f3f4f6; color: #6b7280; font-size: 8px; }
  .mock-marker > header div span.active { background: #ffebf0; color: #e84d75; }
  .mock-marker > header button { margin-left: auto; padding: 7px 11px; border: 0; border-radius: 999px; background: #ff6b91; color: white; font-size: 8px; font-weight: 600; }
  .map-search { position: absolute; z-index: 2; top: 64px; left: 16px; width: 170px; padding: 8px 12px; border-radius: 999px; background: white; color: #9ca3af; font-size: 8px; box-shadow: 0 4px 16px rgba(37,55,62,.1); }
  .pin { position: absolute; z-index: 1; display: grid; width: 28px; height: 36px; place-items: center; border: 3px solid white; border-radius: 50% 50% 50% 6px; transform: rotate(-45deg); box-shadow: 0 4px 12px rgba(0,0,0,.18); }
  .pin span { transform: rotate(45deg); color: white; font-size: 9px; }
  .pin-a { top: 105px; left: 35%; background: #ff6b6b; }
  .pin-b { top: 160px; left: 65%; background: #4ecdc4; }
  .pin-c { top: 85px; left: 76%; background: #6c5ce7; }
  .place-sheet { position: absolute; z-index: 3; right: 18px; bottom: 16px; width: min(52%, 360px); padding: 15px 18px; border-radius: 18px; background: white; box-shadow: 0 16px 50px rgba(20,35,45,.18); }
  .place-sheet > i { display: block; width: 34px; height: 3px; margin: -6px auto 10px; border-radius: 3px; background: #d1d5db; }
  .emotion { width: fit-content; padding: 4px 8px; border-radius: 999px; background: #ff6b6b; color: white; font-size: 8px; font-weight: 600; }
  .place-sheet > strong { display: block; margin-top: 9px; font-size: 12px; }
  .place-sheet > p { margin-top: 6px; color: #6b7280; font-size: 8px; line-height: 1.5; }
  .place-sheet footer { display: flex; justify-content: space-between; margin-top: 10px; padding-top: 8px; border-top: 1px solid #f1f5f9; color: #9ca3af; font-size: 7px; }
  .place-sheet footer b { color: #ff6b6b; }

  /* Rust with TypeScript, based on the Starlight theme variables */
  .mock-rust { display: grid; grid-template: 45px 1fr / 170px 1fr; background: #13100e; color: #f5f0ed; }
  .mock-rust > header { grid-column: 1 / 3; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; border-bottom: 1px solid #2c2218; background: #1b1612; }
  .mock-rust > header strong { font-size: 11px; }
  .mock-rust > header span { color: #b8afa9; font: 500 8px/1 $font-mono; }
  .mock-rust > aside { display: flex; flex-direction: column; gap: 4px; padding: 18px 10px; border-right: 1px solid #2c2218; background: #181310; }
  .mock-rust > aside small { margin: 0 8px 8px; color: #e05a3a; font: 500 7px/1 $font-mono; }
  .mock-rust > aside span { padding: 7px 8px; color: #8f8580; font-size: 8px; }
  .mock-rust > aside span.active { border-left: 2px solid #e05a3a; background: #1e1713; color: #ff8262; }
  .mock-rust > main { min-width: 0; padding: 20px 24px; }
  .doc-title small { color: #e05a3a; font: 500 7px/1 $font-mono; }
  .doc-title strong { display: block; margin-top: 8px; font-size: 17px; }
  .doc-title p { margin-top: 7px; color: #b8afa9; font-size: 8px; }
  .code-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 18px; }
  .code-compare section { min-width: 0; border: 1px solid #2e2018; background: #1e1713; }
  .code-compare header { padding: 8px 10px; border-bottom: 1px solid #2e2018; color: #ddd5d0; font: 500 8px/1 $font-mono; }
  .code-compare code { display: block; padding: 11px; overflow: hidden; color: #b8afa9; font: 400 8px/1.65 $font-mono; white-space: nowrap; }
  .code-compare code i { color: #ff8262; font-style: normal; }
  .code-compare code b { color: #e8b4a4; font-weight: 400; }

  /* Kivra, based on the live landing hero demo */
  .mock-kivra { display: grid; grid-template-rows: 46px 1fr 38px; background: hsl(220 18% 7%); color: hsl(210 20% 96%); }
  .mock-kivra > header { display: flex; align-items: center; justify-content: space-between; padding: 0 15px; border-bottom: 1px solid hsl(220 12% 18%); background: hsl(220 16% 10%); }
  .mock-kivra > header strong { font-size: 11px; }
  .mock-kivra > header div { display: flex; gap: 7px; }
  .mock-kivra > header div span { padding: 5px 7px; border: 1px solid hsl(220 12% 18%); border-radius: 5px; color: hsl(220 10% 67%); font: 500 7px/1 $font-mono; }
  .mock-kivra > header div span.success { border-color: rgba(89,214,194,.35); background: #121d1c; color: #9beadf; }
  .mock-kivra > main { display: grid; grid-template-columns: 1fr 230px; min-height: 0; }
  .terminal-log { padding: 18px; font-family: $font-mono; }
  .terminal-log small, .mock-kivra main aside > small { color: hsl(220 10% 67%); font: 500 7px/1 $font-mono; }
  .terminal-log p { margin-top: 10px; color: #9ca3af; font-size: 8px; }
  .terminal-log p b { color: #59d6c2; }
  .terminal-log p.error { color: #fb7185; }
  .mock-kivra main aside { display: grid; align-content: start; gap: 10px; padding: 16px; border-left: 1px solid hsl(220 12% 18%); background: rgba(255,255,255,.015); }
  .mock-kivra main aside article { display: grid; gap: 5px; padding: 10px; border: 1px solid hsl(220 12% 18%); background: hsl(220 16% 10%); }
  .mock-kivra main aside article b { font-size: 8px; }
  .mock-kivra main aside article span, .mock-kivra main aside article p { color: hsl(220 10% 67%); font-size: 7px; line-height: 1.45; }
  .mock-kivra main aside article.memory { border-color: rgba(89,214,194,.28); }
  .mock-kivra > footer { display: flex; align-items: center; gap: 8px; padding: 0 15px; border-top: 1px solid hsl(220 12% 18%); color: hsl(220 10% 67%); font-size: 8px; }
  .mock-kivra > footer span { width: 7px; height: 7px; border-radius: 50%; background: #59d6c2; }

  /* Bigtablet homepage, based on the video hero and solution rail */
  .mock-homepage { background: #101722; }
  .camera-grid { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(3, 1fr); opacity: .46; }
  .camera-grid i { border: 1px solid rgba(255,255,255,.08); background: linear-gradient(145deg, transparent 42%, rgba(115,135,153,.34) 43%, transparent 44%), radial-gradient(circle at 55% 45%, rgba(255,255,255,.12), transparent 34%); }
  .mock-homepage::after { content: ''; position: absolute; inset: 0; background: rgba(10,15,24,.62); }
  .mock-homepage > header, .mock-homepage > main, .mock-homepage > footer { position: relative; z-index: 1; }
  .mock-homepage > header { height: 50px; display: flex; align-items: center; padding: 0 18px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .mock-homepage > header strong { font-size: 11px; letter-spacing: .12em; }
  .mock-homepage > header nav { display: flex; gap: 18px; margin-left: auto; }
  .mock-homepage > header nav span, .mock-homepage > header small { color: rgba(255,255,255,.58); font: 500 7px/1 $font-mono; }
  .mock-homepage > header small { margin-left: 22px; }
  .mock-homepage > main { display: flex; height: calc(100% - 90px); flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .mock-homepage > main small { color: rgba(255,255,255,.55); font: 500 7px/1 $font-mono; letter-spacing: .12em; }
  .mock-homepage > main strong { margin-top: 10px; font-size: clamp(28px, 5vw, 50px); line-height: .9; }
  .mock-homepage > main p { margin-top: 12px; color: rgba(255,255,255,.72); font-size: 9px; }
  .mock-homepage > main button { margin-top: 15px; padding: 8px 14px; border: 0; background: white; color: #101722; font-size: 8px; font-weight: 600; }
  .mock-homepage > footer { height: 40px; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgba(255,255,255,.12); }
  .mock-homepage > footer span { display: grid; place-items: center; border-right: 1px solid rgba(255,255,255,.1); color: rgba(255,255,255,.64); font-size: 8px; }

  /* Echo, based on the Expo home screen, orange progress and metrics */
  .mock-echo { display: grid; place-items: center; background: #050505; }
  .echo-phone { width: min(66%, 290px); height: 92%; display: grid; grid-template-rows: 50px 1fr 42px; overflow: hidden; border: 1px solid #2a2a2a; border-radius: 24px; background: #111; }
  .echo-phone > header { display: flex; align-items: center; justify-content: space-between; padding: 0 16px; }
  .echo-phone > header div { display: grid; gap: 3px; }
  .echo-phone > header strong { font-size: 13px; }
  .echo-phone > header small { color: #777; font-size: 7px; }
  .connected { padding: 4px 7px; border: 1px solid rgba(255,127,17,.32); border-radius: 999px; color: #ff7f11; font: 500 7px/1 $font-mono; }
  .echo-phone > main { display: flex; flex-direction: column; align-items: center; padding: 8px 20px; }
  .echo-phone > main > small { color: #777; font: 500 7px/1 $font-mono; }
  .echo-toggle { position: relative; display: grid; width: 94px; height: 94px; margin-top: 16px; place-items: center; border: 1px solid rgba(255,127,17,.45); border-radius: 50%; box-shadow: 0 0 0 13px rgba(255,127,17,.06), 0 0 0 27px rgba(255,127,17,.025); }
  .echo-toggle i { width: 30px; height: 30px; border-radius: 50%; background: #ff7f11; }
  .echo-toggle span { position: absolute; bottom: -20px; font-size: 8px; font-weight: 600; }
  .echo-phone > main > p { margin-top: 32px; color: #777; font-size: 8px; }
  .echo-metrics { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 14px; }
  .echo-metrics article { display: flex; min-height: 82px; flex-direction: column; align-items: center; justify-content: center; border: 1px solid #252525; border-radius: 12px; }
  .echo-metrics article > small { color: #777; font-size: 7px; }
  .ring { display: grid; width: 42px; height: 42px; margin-top: 8px; place-items: center; border: 4px solid #2a2a2a; border-top-color: #ff7f11; border-right-color: #ff7f11; border-radius: 50%; }
  .ring b { font-size: 8px; }
  .echo-metrics article > strong { margin-top: 6px; color: #ff7f11; font-size: 25px; }
  .echo-metrics article > span { font-size: 7px; }
  .echo-phone > footer { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #252525; }
  .echo-phone > footer span { display: grid; place-items: center; color: #555; font: 500 6px/1 $font-mono; }
  .echo-phone > footer span.active { color: #ff7f11; }

  /* Chorus, based on the Svelte Studio vertical export card and vinyl scene */
  .mock-chorus { display: grid; grid-template-rows: 44px 1fr 38px; place-items: center; background: #000; font-family: 'Pretendard', sans-serif; }
