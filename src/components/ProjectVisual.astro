---
import type { Locale } from '../i18n';

interface Props {
  projectKey: string;
  locale: Locale;
  variant?: 'compact' | 'detail';
}

const { projectKey, locale, variant = 'compact' } = Astro.props;
const ko = locale === 'ko';
const waveform = [32, 58, 44, 76, 52, 88, 62, 40, 72, 48, 82, 56, 34, 68, 46, 78, 54, 38, 64, 42];
const owkrRoster = [
  { name: 'Alpha#1001', ranks: '다3★ · 플2? · 플3' },
  { name: 'Bravo#1002', ranks: '플1 · 다4★ · 플2' },
  { name: 'Charlie#1003', ranks: '플3 · 다2? · 골1' },
  { name: 'Delta#1004', ranks: '다5★ · 플1? · 플2' },
  { name: 'Echo#1005', ranks: '플2 · 다3? · 다4' },
];
const owkrRows = [
  { role: 'TANK', left: 'Delta#1004', leftRank: '다5', right: 'Hotel#1008', rightRank: '다4' },
  { role: 'DPS', left: 'Bravo#1002', leftRank: '다4', right: 'Echo#1005', rightRank: '다3' },
  { role: 'DPS', left: 'Golf#1007', leftRank: '플3', right: 'Juliet#1010', rightRank: '플4' },
  { role: 'SUPPORT', left: 'Alpha#1001', leftRank: '플3', right: 'Foxtrot#1006', rightRank: '다3' },
  { role: 'SUPPORT', left: 'Charlie#1003', leftRank: '골1', right: 'India#1009', rightRank: '미배치' },
];
---

<div class:list={['project-visual', variant]} data-visual={projectKey}>
  {projectKey === 'notiiv' && (
    <div class="mock mock-notiiv">
      <aside class="notiiv-rail">
        <div class="notiiv-brand"><b>N</b><span>Notiiv</span></div>
        <small class="repo-label">PRODUCT MONOREPO</small>
        <div class="notiiv-apps">
          <span>apps/admin</span>
          <span>apps/owner</span>
          <span>apps/status</span>
          <span class="active">apps/support</span>
        </div>
        <div class="notiiv-packages">
          <small>12 SHARED PACKAGES</small>
          <strong>api · query · schema<br />ui · theme · layouts</strong>
        </div>
      </aside>
      <section class="notiiv-phone">
        <div class="phone-status"><span>9:30</span><i></i></div>
        <div class="phone-title">{ko ? '녹음중' : 'Recording'}</div>
        <div class="meeting-info">
          <strong>{ko ? '제품 전략 회의' : 'Product strategy meeting'}</strong>
          <span>2026.08.05 09:30</span>
          <small>BIGTABLET · Meeting Room A</small>
        </div>
        <div class="waveform">
          {waveform.map((height, index) => <i style={`--bar-height:${height}%; --bar-index:${index}`}></i>)}
        </div>
        <div class="record-button"><span></span></div>
        <strong class="record-time">00:38</strong>
        <div class="memo-mode"><i></i>{ko ? '메모 화면 모드' : 'Memo mode'}</div>
      </section>
      <div class="transcript-panel">
        <small>LIVE TRANSCRIPT</small>
        <p><b>00:31</b>{ko ? '반복되는 제품 로직을 공통 구조로 옮기는 방향을 검토합니다.' : 'We are reviewing how to move repeated product logic into a shared structure.'}</p>
        <p class="current"><b>00:38</b>{ko ? '운영 화면의 실패 지점도 함께 정리하겠습니다.' : 'We will also resolve failure points in operator tools.'}</p>
      </div>
    </div>
  )}

  {projectKey === 'design-system' && (
    <div class="mock mock-ds">
      <header><strong>@bigtablet/design-system</strong><span>Storybook · v3.1</span></header>
      <aside>
        <b>FOUNDATION</b><span>Colors</span><span>Typography</span><span>Spacing</span>
        <b>COMPONENTS</b><span class="active">Button</span><span>TextField</span><span>Sidebar</span><span>Modal</span>
      </aside>
      <main>
        <div class="ds-heading"><small>GENERAL / BUTTON</small><strong>Button</strong><p>{ko ? '행동의 중요도와 상태를 일관된 API로 표현합니다.' : 'Express action hierarchy and state through one consistent API.'}</p></div>
        <div class="ds-canvas">
          <div class="ds-row"><small>Filled</small><button>Continue</button><button disabled>Disabled</button></div>
          <div class="ds-row"><small>Outlined</small><button class="outline">Cancel</button><button class="outline">Preview</button></div>
          <div class="ds-field"><label>Email</label><div>name@company.com</div><small>Supporting text</small></div>
        </div>
      </main>
    </div>
  )}

  {projectKey === 'intranet' && (
    <div class="mock mock-intranet">
      <aside class="intranet-context">
        <small>FLUTTER MOBILE APP</small>
        <strong>{ko ? '업무의 시작과 이동을 하나의 앱 셸로' : 'One app shell for daily work'}</strong>
        <dl>
          <div><dt>Flutter</dt><dd>iOS · Android</dd></div>
          <div><dt>BLoC</dt><dd>{ko ? '상태 관리' : 'State'}</dd></div>
          <div><dt>SQLite</dt><dd>{ko ? '오프라인 캐시' : 'Offline cache'}</dd></div>
        </dl>
      </aside>
      <section class="intranet-phone">
        <div class="intranet-status"><span>9:41</span><i></i></div>
        <header><strong>{ko ? '홈' : 'Home'}</strong><span>●</span></header>
        <main>
          <div class="intranet-stats">
            <article><i>○</i><strong>4</strong><small>{ko ? '알림' : 'Alerts'}</small></article>
            <article><i>□</i><strong>2</strong><small>{ko ? '대기 결재' : 'Approvals'}</small></article>
            <article><i>◇</i><strong>7</strong><small>{ko ? '메일' : 'Mail'}</small></article>
          </div>
          <section class="intranet-calendar">
            <header><strong>{ko ? '일정' : 'Calendar'}</strong><span>{ko ? '전체' : 'View all'}</span></header>
            <div class="week"><span>월<small>3</small></span><span>화<small>4</small></span><span class="today">수<small>5</small></span><span>목<small>6</small></span><span>금<small>7</small></span></div>
            <p><i></i><strong>{ko ? '제품 주간 회의' : 'Weekly product meeting'}</strong><small>10:00 · Meeting Room A</small></p>
          </section>
          <section class="intranet-notice"><header><strong>{ko ? '최근 공지' : 'Recent notices'}</strong><span>SSE · LIVE</span></header><p>{ko ? '8월 전사 일정 안내' : 'August company schedule'}<small>{ko ? '오늘' : 'Today'}</small></p></section>
        </main>
        <footer><span class="active"><i>⌂</i>{ko ? '홈' : 'Home'}</span><span><i>◇</i>{ko ? '메신저' : 'Messenger'}<b></b></span><span><i>▦</i>{ko ? '전체' : 'Apps'}</span></footer>
      </section>
      <section class="intranet-sync">
        <small>APP FLOW</small>
        <div><span class="active">HOME</span><span>MESSENGER</span><span>WORK APPS</span></div>
        <article><i></i><p><strong>{ko ? '캐시부터 즉시 표시' : 'Cache appears first'}</strong><small>SQLite · cache-then-network</small></p></article>
        <article><i></i><p><strong>{ko ? '실시간 상태 병합' : 'Merge live state'}</strong><small>SSE · FCM · deep link</small></p></article>
        <article><i></i><p><strong>{ko ? '부분 실패를 명시' : 'Expose partial failure'}</strong><small>BLoC · recovery state</small></p></article>
      </section>
    </div>
  )}

  {projectKey === 'boundra' && (
    <div class="mock mock-boundra">
      <section class="boundra-intro">
        <small>OPEN SOURCE · RUST CLI</small>
        <strong>BOUNDRA</strong>
        <p>{ko ? '아키텍처가 흐려지기 전에 실패하는 도메인 경계' : 'Domain boundaries that fail before architecture drifts.'}</p>
        <div><span>BR-001</span><span>BR-002</span><span>BR-003</span><span>BR-004</span><span>BR-005</span></div>
      </section>
      <section class="boundra-terminal">
        <header><div><span></span><span></span><span></span></div><strong>boundra · check-boundaries</strong><small>Rust CLI</small></header>
        <main>
          <p><i>$</i> pnpm exec boundra check-boundaries</p>
          <p class="muted">Scanning TypeScript domain graph...</p>
          <section class="diagnostic">
            <div><b>BR-004</b><span>DOMAIN INTERNAL IMPORT</span><em>ERROR</em></div>
            <strong>domains/order/client/view.ts:18:7</strong>
            <code>import {'{ createOrder }'} from '../payment/internal/create-order';</code>
            <p>{ko ? '다른 도메인의 내부 구현을 직접 참조할 수 없습니다.' : 'A domain cannot import another domain internal module.'}</p>
            <small>SUGGESTION · import from domains/payment/public</small>
          </section>
          <footer><span>10,000 files</span><span>5 stable rules</span><strong>164.20 ms</strong></footer>
        </main>
      </section>
    </div>
  )}

  {projectKey === 'owkr' && (
    <div class="mock mock-owkr">
      <header class="owkr-app-header">
        <strong>OWKR Balance</strong>
        <nav><span class="scrim">▦ 내전 관리</span><span class="sheet">▤ 유저 시트</span><span>▱ 매칭 가이드</span></nav>
        <small>운영자</small>
      </header>
      <main class="owkr-dashboard">
        <aside class="owkr-sidebar">
          <section class="owkr-card owkr-roster-summary">
            <header><div><i>♙</i><strong>참가 명단</strong></div><b>10/10</b></header>
            <p>입력과 대조는 넓은 참가자 작업실에서 관리합니다.</p>
            <div class="owkr-progress"><i></i></div>
            <dl><div><dt>◷ 대기열</dt><dd>0명</dd></div><div><dt>◉ 정보 보완</dt><dd>0명</dd></div></dl>
            <button>참가자 추가·관리 <span>→</span></button>
          </section>
          <section class="owkr-card owkr-player-list">
            <header><strong>♙ 참가자 관리 <small>총 10명</small></strong><span>전체 삭제</span></header>
            <div class="owkr-tabs"><b>♙ 참가자 <em>10/10</em></b><span>◷ 대기열 <em>0</em></span></div>
            <ul>{owkrRoster.map((player) => <li><strong>{player.name}</strong><small>{player.ranks}</small></li>)}</ul>
          </section>
        </aside>
        <section class="owkr-result">
          <header class="owkr-result-head"><strong>팀 배정 결과</strong><div><span>☆ 선호 무시</span><span>↻ 결과 지우기</span><b>⌘ 팀 자동 배정</b></div></header>
          <section class="owkr-card owkr-balance-summary">
            <header><strong>▥ 밸런스 요약</strong><small>1팀 11,300 · 2팀 10,760</small></header>
            <dl>
              <div class="total"><dt>총점 차이</dt><dd>540</dd></div>
              <div><dt>탱커</dt><dd>2팀 +200점</dd></div>
              <div><dt>딜러</dt><dd>2팀 +20점</dd></div>
              <div><dt>힐러</dt><dd class="blue">1팀 +390점</dd></div>
            </dl>
            <div class="owkr-exceptions"><span>선호 역할 이탈 <b>1명</b></span><span>비선호 배정 <b>1명</b></span><span>미배치 역할 <b>1명</b></span></div>
          </section>
          <div class="owkr-swap-guide">↔ 결과표에서 플레이어 두 명을 차례로 선택하면 자리를 바꿀 수 있습니다</div>
          <div class="owkr-rank-toggle">탱·딜·힐 티어 표시 <i><b></b></i></div>
          <section class="owkr-matchup">
            <header><div><strong>1팀</strong><span>선공격</span></div><div><span>선수비</span><strong>2팀</strong></div></header>
            {owkrRows.map((row, index) => (
              <div class="owkr-match-row">
                <span class="player left">{index < 2 && <i>★</i>}<strong>{row.left}</strong><small>◇ {row.leftRank}</small></span>
                <span class:list={['owkr-role', row.role.toLowerCase()]}>
                  {row.role === 'TANK' && <svg viewBox="0 0 32 32"><path d="M16 2.5 3.5 6.5S2 20 16 29.5C30 20 28.5 6.5 28.5 6.5Z" /></svg>}
                  {row.role === 'DPS' && <svg viewBox="0 0 32 32"><path d="m6 26 5-20h4.5l-5 20Zm7.5 0 5-20H23l-5 20Zm7.5 0 5-20h4.5l-5 20Z" /></svg>}
                  {row.role === 'SUPPORT' && <svg viewBox="0 0 32 32"><path d="M13 5h6v8h8v6h-8v8h-6v-8H5v-6h8Z" /></svg>}
                </span>
                <span class="player right"><small>{row.rightRank} ◇</small><strong>{row.right}</strong>{index === 4 && <i>★</i>}</span>
              </div>
            ))}
          </section>
        </section>
      </main>
    </div>
  )}

  {projectKey === 'jeomjuro' && (
    <div class="mock mock-jeomjuro">
      <section class="jeomjuro-consumer-surface">
        <header class="jeomjuro-consumer-header">
          <div class="jeomjuro-logo">
            <img src="/projects/jeomjuro/non-favicon.svg" alt="" aria-hidden="true" />
            <img src="/projects/jeomjuro/non-logo.svg" alt="점주로" />
          </div>
          <div class="jeomjuro-search"><span>{ko ? '자영업의 시작, 점주로!' : 'Start your business with Jeomjuro'}</span><svg viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg></div>
          <div class="jeomjuro-bell"><svg viewBox="0 0 20 20"><path d="M4.5 14.5h11l-1.2-1.8V8a4.3 4.3 0 0 0-8.6 0v4.7Z"/><path d="M8 16.5h4"/></svg></div>
        </header>
        <nav class="jeomjuro-nav"><span class="active"><svg viewBox="0 0 16 16"><path d="M2 4h12M2 8h12M2 12h12"/></svg>{ko ? '커뮤니티' : 'Community'}</span><span>{ko ? '브랜드' : 'Brands'}</span><span>{ko ? '대시보드' : 'Dashboard'}</span><span>{ko ? '서비스 소개' : 'About'}</span></nav>

        <main class="jeomjuro-consumer-main">
          <section class="jeomjuro-top">
            <img class="jeomjuro-banner" src="/projects/jeomjuro/top4.svg" alt={ko ? '점주로 브랜드 배너' : 'Jeomjuro brand banner'} />
            <div class="jeomjuro-profile"><div><i></i><span><strong>{ko ? '게스트' : 'Guest'}</strong><small>{ko ? '로그인 후 이용 가능' : 'Sign in to continue'}</small></span></div><button>{ko ? '로그인' : 'Sign in'}</button></div>
          </section>

          <section class="jeomjuro-interest">
            <h2>{ko ? '관심 게시판' : 'Favorite boards'}</h2>
            <div><span><i></i><small>{ko ? '자유 게시판' : 'General'}</small></span><span><i></i><small>{ko ? '창업 질문' : 'Starting up'}</small></span><span><i></i><small>{ko ? '점주 노하우' : 'Owner tips'}</small></span><span><i></i><small>{ko ? '브랜드 소식' : 'Brand news'}</small></span></div>
          </section>

          <section class="jeomjuro-feed">
            <div class="jeomjuro-hot">
              <header><strong>{ko ? '관심 게시판 인기글' : 'Popular posts'}</strong></header>
              <div>
                <article><b>HOT</b><strong>{ko ? '재고 관리, 다들 어떻게 하고 계신가요?' : 'How do you manage inventory?'}</strong><p>{ko ? '점주들이 직접 나눈 운영 경험과 정보를 확인해보세요.' : 'Practical knowledge shared by store owners.'}</p><small>조회 128 · 좋아요 12 · 댓글 4</small></article>
                <article><b>HOT</b><strong>{ko ? '배달 플랫폼 수수료 비교해 봤습니다' : 'Comparing delivery platform fees'}</strong><p>{ko ? '이번 달 정산 내용을 기준으로 항목별 차이를 정리했습니다.' : 'A breakdown based on this month’s settlement.'}</p><small>조회 96 · 좋아요 19 · 댓글 5</small></article>
              </div>
            </div>
            <aside class="jeomjuro-best"><header><strong>{ko ? '실시간 점주로 BEST' : 'Jeomjuro Best'}</strong></header><nav><b>{ko ? '커뮤니티' : 'Community'}</b><span>{ko ? '브랜드' : 'Brands'}</span></nav><div><b>01</b><span>{ko ? '요즘 손님 반응 좋은 메뉴' : 'Popular menu ideas'}</span></div><div><b>02</b><span>{ko ? '오픈 준비 체크리스트' : 'Opening checklist'}</span></div><div><b>03</b><span>{ko ? '매장 운영비 절약 팁' : 'Saving operating costs'}</span></div></aside>
          </section>
        </main>
      </section>

      <aside class="jeomjuro-subsystems">
        <section class="jeomjuro-admin"><header><span>apps/admin</span><b>{ko ? '관리자 로그인과 운영 도구' : 'Admin access and operations'}</b></header><div><img src="/projects/jeomjuro/non-logo.svg" alt="" /><i></i><i></i><button>{ko ? '로그인' : 'Sign in'}</button></div></section>
        <section class="jeomjuro-ds"><header><span>packages/design-system</span><b>{ko ? '공통 UI 기반' : 'Shared UI foundation'}</b></header><div><button>Primary</button><button class="outline">Secondary</button><label><span>Text field</span></label></div></section>
        <footer><small>MONOREPO</small><b>pnpm · Turborepo</b><span>consumer · admin · storybook</span></footer>
      </aside>
    </div>
  )}

  {projectKey === 'marker' && (
    <div class="mock mock-marker">
      <div class="map-grid"></div>
      <header><strong>Marker</strong><div><span class="active">{ko ? '전체' : 'All'}</span><span>{ko ? '설렘' : 'Excitement'}</span><span>{ko ? '편안함' : 'Comfort'}</span></div><button>{ko ? '기록하기' : 'Write'}</button></header>
      <div class="map-search">{ko ? '장소를 검색하세요' : 'Search a place'}</div>
      <div class="pin pin-a"><span>♥</span></div><div class="pin pin-b"><span>☁</span></div><div class="pin pin-c"><span>★</span></div>
      <section class="place-sheet"><i></i><div class="emotion">♥ {ko ? '설렘' : 'Excitement'}</div><strong>{ko ? '한강에서 본 오늘의 노을' : 'Today’s sunset by the river'}</strong><p>{ko ? '좋아하는 사람들과 함께 걷던 순간을 기록했어요.' : 'A quiet walk with people I care about.'}</p><footer><span>{ko ? '서울 영등포구 여의동로' : 'Yeouido, Seoul'}</span><b>♥ 24</b></footer></section>
    </div>
  )}

  {projectKey === 'rust-with-typescript' && (
    <div class="mock mock-rust">
      <header><strong>Rust with TypeScript</strong><span>KO / EN</span></header>
      <aside><small>LEARN RUST</small><span>01 Introduction</span><span class="active">02 Ownership</span><span>03 Borrowing</span><span>04 Enums</span><span>05 Traits</span></aside>
      <main><div class="doc-title"><small>02 · OWNERSHIP</small><strong>{ko ? '소유권을 익숙한 모델로 이해하기' : 'Understand ownership through a familiar model'}</strong><p>{ko ? '같은 데이터를 TypeScript와 Rust가 어떻게 다르게 다루는지 비교합니다.' : 'Compare how TypeScript and Rust handle the same data.'}</p></div>
        <div class="code-compare"><section><header>TypeScript</header><code><i>const</i> user = {'{'} name: <b>'Sangmin'</b> {'}'};<br/><i>const</i> next = user;<br/>console.log(user.name);</code></section><section><header>Rust</header><code><i>let</i> user = User {'{'} name: <b>String::from("Sangmin")</b> {'}'};<br/><i>let</i> next = user;<br/>println!("{'{}'}", user.name);</code></section></div>
      </main>
    </div>
  )}

  {projectKey === 'kivra' && (
    <div class="mock mock-kivra">
      <header><strong>Kivra</strong><div><span>pnpm build</span><span class="success">Memory updated</span></div></header>
      <main><section class="terminal-log"><small>TERMINAL CAPTURE</small><p><b>$</b> pnpm build</p><p>vite v5.4.21 building for production...</p><p>✓ 142 modules transformed.</p><p class="error">Type error: selected node is not reachable</p><p>src/features/project/code-node-viewer.tsx:122</p></section>
        <aside><small>DETECTED ERROR</small><article><b>code-node-viewer.tsx</b><span>line 122 · Type error</span></article><small>PROJECT MEMORY</small><article class="memory"><b>Resolution attached</b><p>Preserve selected node id only after the graph has rebuilt.</p></article></aside></main>
      <footer><span></span>{ko ? '실행, 오류, 파일 경로와 해결 기록을 함께 저장했습니다.' : 'Run, error, file path, and resolution are stored together.'}</footer>
    </div>
  )}

  {projectKey === 'homepage' && (
    <div class="mock mock-homepage">
      <div class="camera-grid"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <header><strong>BIGTABLET</strong><nav><span>TECHNOLOGY</span><span>ABOUT</span><span>NEWS</span></nav><small>KO / EN</small></header>
      <main><small>VIDEO UNDERSTANDING AI</small><strong>Vision<br/>Beyond Pixels</strong><p>{ko ? '매장, 공장, 현장의 영상을 실시간으로 이해합니다.' : 'Understand video from stores, factories, and worksites in real time.'}</p><button>{ko ? '도입 상담' : 'Contact us'}</button></main>
