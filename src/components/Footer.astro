---
import type { Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const year = new Date().getFullYear();
---
<footer><div class="shell footer-inner"><p>{locale === 'ko' ? '박상민' : 'Park Sangmin'}</p><p>© {year}</p></div></footer>
<style lang="scss">
  @use '../styles/tokens' as *;
  footer { padding: 32px 0; }.footer-inner { display: flex; justify-content: space-between; gap: 24px; }p { color: $gunmetal; font-size: 13px; }
</style>
