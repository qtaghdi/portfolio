---
import { copy, localePath, type Locale } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dictionary = copy[locale];
const home = localePath(locale);
const isProject = Astro.url.pathname.includes('/projects/');
const section = (id: string) => `${isProject ? home : ''}#${id}`;
const koPath = Astro.url.pathname.startsWith('/en/') ? Astro.url.pathname.slice(3) || '/' : Astro.url.pathname;
const enPath = Astro.url.pathname.startsWith('/en/') ? Astro.url.pathname : `/en${Astro.url.pathname === '/' ? '/' : Astro.url.pathname}`;
---

<header class="site-header" id="site-header">
  <nav class="nav-shell" aria-label={locale === 'ko' ? '주요 메뉴' : 'Primary navigation'}>
    <a class="brand" href={home} aria-label={locale === 'ko' ? '박상민 포트폴리오 홈' : 'Park Sangmin portfolio home'}>PARK SANGMIN</a>
    <div class="nav-right">
      <ul class="nav-links">
        <li><a href={section('projects')}>{dictionary.nav.work}</a></li>
        <li><a href={section('about')}>{dictionary.nav.about}</a></li>
        <li><a href={section('contact')}>{dictionary.nav.contact}</a></li>
      </ul>
      <div class="language" aria-label={locale === 'ko' ? '언어 선택' : 'Language selection'}>
        <a href={koPath} aria-current={locale === 'ko' ? 'page' : undefined}>KR</a>
        <span aria-hidden="true">/</span>
        <a href={enPath} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
      </div>
    </div>
  </nav>
</header>

<style lang="scss">
  @use '../styles/tokens' as *;
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    background: rgba(0, 0, 0, .72);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(16px);
    transition: border-color $fast;
  }
  .site-header.scrolled { border-color: $line; }
  .nav-shell {
    width: min(1440px, calc(100% - 96px));
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-inline: auto;
  }
  .brand, .nav-links a, .language {
    font: 500 .67rem/1 $font-mono;
    letter-spacing: .14em;
  }
  .brand { color: $silver-bright; }
  .nav-right, .nav-links, .language { display: flex; align-items: center; }
  .nav-right { gap: 48px; }
  .nav-links { gap: 34px; list-style: none; }
  .nav-links a, .language a { color: $silver; transition: color $fast; }
  .nav-links a:hover, .language a:hover, .language a[aria-current='page'] { color: $silver-bright; }
  .language { gap: 8px; color: $gunmetal; }
  @media (max-width: 760px) {
    .nav-shell { width: calc(100% - 40px); height: 68px; }
    .nav-right { gap: 20px; }
    .nav-links { gap: 18px; }
    .nav-links li:nth-child(2), .nav-links li:nth-child(3) { display: none; }
    .brand, .nav-links a, .language { font-size: .61rem; letter-spacing: .1em; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const updateHeader = () => header?.classList.toggle('scrolled', window.scrollY > 12);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>
