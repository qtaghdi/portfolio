---
import { copy, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const dictionary = copy[locale].contact;
const links = [
  { label: 'EMAIL', href: 'mailto:qtaghdi@gmail.com' },
  { label: 'GITHUB', href: 'https://github.com/qtaghdi' },
  { label: 'VELOG', href: 'https://velog.io/@qtaghdi/posts' },
  { label: 'LINKEDIN', href: 'https://www.linkedin.com/in/sangminpp/' },
];
---

<section id="contact" class="contact-section">
  <div class="shell contact-inner reveal">
    <p class="eyebrow">{dictionary.kicker}</p>
    <h2>{dictionary.title.split('\n').map((line) => <span>{line}</span>)}</h2>
    <div class="contact-foot">
      <p>{dictionary.description}</p>
      <div class="contact-links">
        {links.map((link) => (
          <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {link.label}
            <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 16 16 4M7 4h9v9" /></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;
  .contact-section { padding: clamp(110px, 15vw, 220px) 0 70px; border-top: 1px solid $line; }
  h2 { margin-top: 40px; font-size: clamp(3rem, 8.4vw, 8.8rem); font-weight: 500; line-height: .96; letter-spacing: -.075em; }
  h2 span { display: block; word-break: keep-all; }
  .contact-foot { display: grid; grid-template-columns: .8fr 1.2fr; gap: 90px; margin-top: clamp(70px, 10vw, 140px); padding-top: 24px; border-top: 1px solid $line-bright; }
  .contact-foot > p { max-width: 470px; color: $silver; font-size: 1rem; line-height: 1.85; word-break: keep-all; }
  .contact-links { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
  .contact-links a { display: flex; align-items: center; justify-content: space-between; padding-bottom: 13px; border-bottom: 1px solid $line; color: $silver; font: 500 .7rem/1 $font-mono; letter-spacing: .1em; }
  .contact-links svg { width: 16px; fill: none; stroke: currentColor; stroke-width: 1.2; }
  @media (max-width: 780px) {
    .contact-foot { grid-template-columns: 1fr; gap: 52px; }
    .contact-links { grid-template-columns: 1fr; }
  }
</style>
