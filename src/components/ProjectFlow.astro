---
import type { Locale } from '../i18n';
import { projectFlows, type ProjectFlowId } from '../data/project-flows';

interface Props {
  id: ProjectFlowId;
  locale?: Locale;
}

const { id, locale = 'ko' } = Astro.props;
const { caption, steps } = projectFlows[id][locale];
---
<figure class="project-flow" data-case-flow={id}>
  <figcaption>{caption}</figcaption>
  <ol role="list">
    {steps.map(({ label, detail }) => (
      <li><strong>{label}</strong><span>{detail}</span></li>
    ))}
  </ol>
</figure>
<style lang="scss">
  @use '../styles/tokens' as *;

  .project-flow { margin: 28px 0 36px; }
  figcaption { margin-bottom: 10px; color: $silver; font-size: 14px; line-height: 1.55; }
  ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    position: relative;
    padding: 14px;
    border: 1px solid $line;
    background: $black-soft;
    font-size: 14px;
    line-height: 1.55;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  li::after {
    position: absolute;
    top: 50%;
    right: -18px;
    width: 8px;
    height: 8px;
    border-top: 1px solid $gunmetal;
    border-right: 1px solid $gunmetal;
    transform: translateY(-50%) rotate(45deg);
    content: '';
  }
  li:last-child { border-color: $accent; }
  li:last-child::after { display: none; }
  strong, span { display: block; }
  strong { margin-bottom: 4px; color: $silver-bright; font-size: 15px; }
  span { color: $silver; }

  @media (max-width: 680px) {
    ol { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    li::after {
      top: auto;
      right: 50%;
      bottom: -13px;
      transform: translateX(50%) rotate(135deg);
    }
  }
</style>
