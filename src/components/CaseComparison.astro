---
import type { Locale } from '../i18n';
import TechnicalDiagram from './TechnicalDiagram.astro';
import JuliyaComparison from './JuliyaComparison.astro';
interface Props { projectKey: string; locale: Locale; }
const { projectKey, locale } = Astro.props;
const diagrams = new Set(['design-system', 'notiiv', 'owkr', 'intranet', 'apple-music-discord-presence', 'kivra', 'jeomjuro', 'homepage', 'echo']);
---
{projectKey === 'juliya' ? <JuliyaComparison locale={locale} /> : diagrams.has(projectKey) && <TechnicalDiagram id={projectKey} locale={locale} />}
