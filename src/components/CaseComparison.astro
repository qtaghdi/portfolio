---
import type { Locale } from '../i18n';
import { caseVisuals } from '../data/case-visuals';
interface Props { projectKey: string; locale: Locale; }
const { projectKey, locale } = Astro.props;
const visual = caseVisuals[projectKey]?.[locale];
const isWrapping = projectKey === 'juliya';
---
{visual && <figure class="case-comparison" data-case-comparison={projectKey} aria-labelledby="case-comparison-title" data-fidelity="explanation">
  <figcaption id="case-comparison-title">
    <span class="eyebrow">{locale === 'ko' ? '기술적 변화 한눈에 보기' : 'Technical change at a glance'}</span>
    <strong>{visual[0]}</strong>
  </figcaption>
  <div class:list={['comparison-grid', { wrapping: isWrapping }]}>
    {[{ label: visual[1], steps: visual[2] }, { label: visual[3], steps: visual[4] }].map((panel, index) => (
      <div class:list={['comparison-panel', { proposed: index === 1 }]}>
        <div class="panel-label">{panel.label}</div>
        {isWrapping ? <div class="sample-lines">{panel.steps.map((line) => <span>{line}</span>)}</div> :
          <ol>{panel.steps.map((step) => <li><span>{step}</span></li>)}</ol>}
      </div>
    ))}
  </div>
  <div class="comparison-result">
    <span class="result-label">{locale === 'ko' ? '핵심' : 'Key takeaway'}</span>
    <span>{visual[5]}</span>
  </div>
  <p class="annotation">{locale === 'ko' ? '본문의 구현 내용을 요약한 설명용 도식입니다. 실제 제품 캡처나 측정 결과가 아닙니다.' : 'Explanatory diagram summarizing the implementation described below, not a product capture or measured result.'}</p>
</figure>}
<style lang="scss">
  @use '../styles/tokens' as *;
  .case-comparison { margin: 0 0 40px; min-width: 0; }
  figcaption { display: grid; gap: 4px; margin: 0 0 16px; }
  .eyebrow { color: $gunmetal; font-size: 12px; line-height: 1.6; }
  figcaption strong { color: $silver-bright; font-size: 20px; font-weight: 600; line-height: 1.5; letter-spacing: -.02em; }
  .comparison-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .comparison-panel { padding: 16px; border: 1px solid $line; background: $black-soft; border-radius: 8px; min-width: 0; }
  .comparison-panel.proposed { border-color: $accent; background: $black; }
  .panel-label { margin-bottom: 16px; color: $silver-bright; font-size: 14px; font-weight: 600; line-height: 1.5; }
  .proposed .panel-label { color: $accent; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 15px; }
  li { position: relative; display: grid; padding: 10px 12px; border: 1px solid $line; border-radius: 4px; background: $black; color: $silver; font-size: 14px; line-height: 1.65; min-width: 0; overflow-wrap: anywhere; }
  li:not(:last-child)::after { content: ''; position: absolute; left: 50%; bottom: -12px; height: 8px; width: 1px; background: $line-bright; }
  .proposed li:last-child { color: $accent; font-weight: 600; border-color: $accent; }
  .sample-lines { padding: 12px; border: 1px solid $line; background: $black; color: $silver-bright; font-size: 13px; line-height: 1.85; overflow-wrap: anywhere; }
  .sample-lines span { display: block; }
  .comparison-result { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: baseline; margin-top: 12px; padding: 12px 16px; border-left: 2px solid $accent; background: $black-soft; color: $silver; font-size: 14px; line-height: 1.7; overflow-wrap: anywhere; }
  .result-label { color: $accent; font-weight: 600; }
  .annotation { margin: 10px 0 0; font-size: 12px; color: $gunmetal; line-height: 1.6; overflow-wrap: anywhere; }
  @media (max-width: 680px) { .comparison-grid { grid-template-columns: minmax(0, 1fr); } .case-comparison { margin-bottom: 32px; } }
</style>
