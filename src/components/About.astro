---
import { copy, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const dictionary = copy[locale].about;
---

<section id="about" class="about-section">
  <div class="shell">
    <header class="about-head reveal">
      <p class="eyebrow">{dictionary.kicker}</p>
      <h2>{dictionary.statement.split('\n').map((line) => <span>{line}</span>)}</h2>
      <p class="about-description">{dictionary.description}</p>
    </header>

    <div class="principles reveal">
      {dictionary.principles.map(([index, title, description]) => (
        <article>
          <span>{index}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>

    <div class="profile reveal">
      <span>{dictionary.profile[0]}</span>
      <span>{dictionary.profile[1]}</span>
      <span>{dictionary.profile[2]}</span>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;
  .about-section { padding: clamp(120px, 16vw, 240px) 0 clamp(100px, 13vw, 190px); border-top: 1px solid $line; }
  .about-head { display: grid; grid-template-columns: .55fr 1.35fr .65fr; gap: 48px; align-items: start; }
  .about-head h2 { font-size: clamp(2.6rem, 5.4vw, 5.9rem); font-weight: 500; line-height: 1.04; letter-spacing: -.065em; }
  .about-head h2 span { display: block; word-break: keep-all; }
  .about-description { max-width: 410px; color: $silver; font-size: 1rem; line-height: 1.9; word-break: keep-all; }
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(92px, 11vw, 150px); border-top: 1px solid $line-bright; }
  .principles article { min-height: 230px; padding: 24px 30px 32px 0; border-right: 1px solid $line; }
  .principles article + article { padding-left: 30px; }
  .principles article:last-child { border-right: 0; }
  .principles article > span { color: $gunmetal; font: 500 .66rem/1 $font-mono; }
  .principles h3 { margin-top: 74px; font-size: 1.2rem; font-weight: 500; }
  .principles p { margin-top: 13px; color: $silver; font-size: .94rem; line-height: 1.75; }
  .profile { display: grid; grid-template-columns: .55fr 1.35fr .65fr; gap: 48px; margin-top: 100px; padding-top: 20px; border-top: 1px solid $line; color: $gunmetal; font: 500 .66rem/1.45 $font-mono; letter-spacing: .07em; }
  @media (max-width: 840px) {
    .about-head { grid-template-columns: 1fr; gap: 24px; }
    .about-description { max-width: 580px; }
    .principles { grid-template-columns: 1fr; }
    .principles article, .principles article + article { min-height: 0; padding: 24px 0 32px; border-right: 0; border-bottom: 1px solid $line; }
    .principles h3 { margin-top: 42px; }
    .profile { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
