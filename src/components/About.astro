---
import { copy, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const dictionary = copy[locale].about;
const focus = locale === 'ko'
  ? ['제품 전반의 UI 기준', '안전한 인증 흐름', '예측 가능한 데이터 경계', '모노레포 안의 협업 방식']
  : ['Product-wide UI standards', 'Safe authentication flows', 'Predictable data boundaries', 'Collaboration inside a monorepo'];
---

<section id="about" class="about-section">
  <div class="shell about-grid reveal">
    <div class="section-index">
      <span>About</span>
      <strong>{locale === 'ko' ? '소개' : 'About'}</strong>
    </div>
    <div class="about-copy">
      <h2>{dictionary.statement.split('\n').map((line) => <span>{line}</span>)}</h2>
      <p>{dictionary.description}</p>
      <p class="personal-note">
        {locale === 'ko'
          ? '새 기술 자체보다 왜 이 구조가 필요한지, 동료가 다음 변경을 얼마나 쉽게 이어갈 수 있는지를 설명할 수 있는 개발자가 되고 싶습니다.'
          : 'I want to explain why a structure is needed and make the next change easier for a teammate, rather than chase technology for its own sake.'}
      </p>
    </div>
    <aside>
      <h3>{locale === 'ko' ? '요즘 집중하는 문제' : 'Problems I am focused on'}</h3>
      <ol>
        {focus.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>)}
      </ol>
      <dl>
        <div><dt>{locale === 'ko' ? '역할' : 'Role'}</dt><dd>Frontend Engineer</dd></div>
        <div><dt>{locale === 'ko' ? '위치' : 'Based'}</dt><dd>Daegu, Korea</dd></div>
      </dl>
    </aside>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;
  .about-section { padding: clamp(100px, 12vw, 170px) 0; border-top: 1px solid $line-bright; }
  .about-grid { display: grid; grid-template-columns: .28fr 1.18fr .54fr; gap: clamp(40px, 6vw, 92px); align-items: start; }
  .section-index { display: grid; gap: 13px; }
  .section-index span { color: $accent; font: 600 .64rem/1 $font-mono; }
  .section-index strong { font-size: 1rem; font-weight: 600; }
  .about-copy h2 { font-size: clamp(2.35rem, 4.3vw, 4.5rem); font-weight: 500; line-height: 1.17; letter-spacing: -.055em; }
  .about-copy h2 span { display: block; word-break: keep-all; }
  .about-copy > p { max-width: 710px; margin-top: 36px; color: $silver; font-size: 1.03rem; line-height: 1.92; word-break: keep-all; }
  .about-copy .personal-note { margin-top: 20px; color: $gunmetal; font-size: .9rem; }
  aside { padding-top: 4px; }
  aside h3 { padding-bottom: 17px; border-bottom: 1px solid $silver-bright; font-size: .82rem; font-weight: 600; }
  aside ol { list-style: none; }
  aside li { display: grid; grid-template-columns: 35px 1fr; padding: 14px 0; border-bottom: 1px solid $line; color: $silver; font-size: .86rem; }
  aside li span, dt { color: $gunmetal; font: 500 .59rem/1.6 $font-mono; }
  aside dl { margin-top: 32px; }
  aside dl > div { display: grid; grid-template-columns: 58px 1fr; gap: 14px; padding: 5px 0; }
  dd { color: $gunmetal; font: 500 .64rem/1.6 $font-mono; }
  @media (max-width: 980px) {
    .about-grid { grid-template-columns: .25fr 1fr; }
    aside { grid-column: 2; max-width: 520px; margin-top: 30px; }
  }
  @media (max-width: 680px) {
    .about-section { padding: 82px 0; }
    .about-grid { grid-template-columns: 1fr; gap: 42px; }
    aside { grid-column: 1; margin-top: 8px; }
    .about-copy h2 { font-size: 2.45rem; }
  }
</style>
