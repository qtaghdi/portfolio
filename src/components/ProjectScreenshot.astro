---
import type { Locale } from '../i18n';
import { caseScreen } from '../data/project-screens';

interface Props { projectKey: string; screen?: string; locale?: Locale; }
const { projectKey, screen = 'primary', locale = 'ko' } = Astro.props;
const image = caseScreen(projectKey, screen);
const caption = image[locale];
const openLabel = locale === 'ko' ? '원본 보기' : 'View original';
---
<figure id={`screen-${projectKey}-${screen}`} class:list={['case-screenshot', { portrait: image.height > image.width }]} style={image.height > image.width ? `max-width: ${Math.min(440, image.width)}px` : undefined} data-case-image={`${projectKey}/${screen}`} data-visual={screen === 'primary' ? projectKey : undefined} data-fidelity="original">
  <a href={image.src} target="_blank" rel="noopener noreferrer" aria-label={`${caption} (${openLabel})`}>
    <img src={image.src} width={image.width} height={image.height} alt={caption} loading="lazy" decoding="async" data-original-screen={screen === 'primary' || undefined} data-supplemental-screen={screen !== 'primary' || undefined} />
  </a>
  <figcaption>{caption} <a href={image.src} target="_blank" rel="noopener noreferrer">{openLabel}</a></figcaption>
</figure>
<style lang="scss">
  @use '../styles/tokens' as *;
  .case-screenshot { margin: 32px 0 40px; width: 100%; scroll-margin-top: 108px; }
  .case-screenshot.portrait { max-width: 440px; }
  .case-screenshot > a { display: block; }
  .case-screenshot img { display: block; width: 100%; height: auto; object-fit: contain; object-position: center; border: 1px solid $line; }
  figcaption { margin-top: 12px; color: $gunmetal; font-size: 13px; line-height: 1.8; word-break: keep-all; overflow-wrap: anywhere; }
  figcaption a { margin-left: 8px; color: $accent; text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid $accent; outline-offset: 4px; }
  @media (max-width: 680px) { .case-screenshot { margin: 24px 0 32px; } }
</style>
