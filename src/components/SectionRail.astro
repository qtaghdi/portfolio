---
interface Props { chapters: { id: string; title: string }[]; label: string; }
const { chapters, label } = Astro.props;
---
<nav class="section-rail" aria-label={label}>
  <p class="rail-label">{label}</p>
  <div class="rail-links">
    {chapters.map((chapter, index) => <a href={`#${chapter.id}`} aria-current={index === 0 ? 'location' : undefined}>{chapter.title}</a>)}
  </div>
</nav>
<script>
  document.querySelectorAll<HTMLElement>('.section-rail').forEach((rail) => {
    const links = [...rail.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    const track = rail.querySelector<HTMLElement>('.rail-links');
    const article = rail.closest('.case-layout')?.querySelector('article');
    const compact = window.matchMedia('(max-width: 960px)');
    let queued = false;
    let active = -1;
    const update = () => {
      queued = false;
      const readingLine = compact.matches ? rail.getBoundingClientRect().bottom + 24 : 112;
      let current = 0;
      targets.forEach((target, index) => {
        if (target && target.getBoundingClientRect().top <= readingLine + 1) current = index;
      });
      if (article && article.getBoundingClientRect().bottom <= window.innerHeight && article.getBoundingClientRect().top < readingLine) current = links.length - 1;
      if (active === current) return;
      active = current;
      links.forEach((link, index) => {
        if (index === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (track && compact.matches) {
        const link = links[current];
        track.scrollTo({ left: link.offsetLeft - (track.clientWidth - link.offsetWidth) / 2, behavior: 'instant' });
      } else if (track && links[current]) {
        const item = links[current].getBoundingClientRect();
        const bounds = track.getBoundingClientRect();
        if (item.top < bounds.top) track.scrollTop -= bounds.top - item.top;
        else if (item.bottom > bounds.bottom) track.scrollTop += item.bottom - bounds.bottom;
      }
    };
    const schedule = () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('load', schedule, { once: true });
    if (article) new ResizeObserver(schedule).observe(article);
    document.fonts.ready.then(schedule);
    update();
  });
</script>
<style lang="scss">
  @use '../styles/tokens' as *;
  .section-rail { position: sticky; top: 108px; align-self: start; min-width: 0; }
  .rail-label { margin-bottom: 16px; color: $gunmetal; font-size: 12px; font-weight: 500; }
  .rail-links { position: relative; display: grid; max-height: calc(100dvh - 168px); overflow-y: auto; overscroll-behavior: contain; }
  a { display: block; padding: 10px 0 10px 16px; border-left: 1px solid $line; color: $silver; font-size: 13px; line-height: 1.65; word-break: keep-all; overflow-wrap: anywhere; text-decoration: none; transition: color .15s, border-color .15s; }
  a:hover { color: $silver-bright; }
  a[aria-current] { border-left: 2px solid $accent; padding-left: 15px; color: $accent; font-weight: 600; }
  a:focus-visible { outline: 2px solid $accent; outline-offset: -2px; }
  @media (max-width: 960px) {
    .section-rail { z-index: 20; top: 76px; padding: 8px 0; background: #fff; border-bottom: 1px solid $line; }
    .rail-label { margin-bottom: 4px; }
    .rail-links { display: flex; gap: 20px; max-height: none; overflow-x: auto; overflow-y: hidden; scrollbar-width: thin; }
    a { flex: 0 0 auto; padding: 8px 0; border-left: 0; border-bottom: 2px solid transparent; font-size: 13px; white-space: nowrap; }
    a[aria-current] { padding-left: 0; border-left: 0; border-bottom-color: $accent; }
  }
  @media (max-width: 680px) { .section-rail { top: 68px; } }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
