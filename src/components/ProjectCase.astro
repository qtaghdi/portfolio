---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import { copy, localePath, projectPath, type Locale } from '../i18n';
import { projectEn, projectKey } from '../i18n/projects';
import ProjectVisual from './ProjectVisual.astro';
import ProjectText from './ProjectText.astro';
import SectionRail from './SectionRail.astro';
import ProjectScreenshot from './ProjectScreenshot.astro';
import { englishScreens } from '../data/project-screens';
interface Props { locale: Locale; project: CollectionEntry<'projects'>; }
const { locale, project } = Astro.props;
const { Content, headings } = await project.render();
const key = projectKey(project.slug);
const translation = projectEn[key];
const data = locale === 'en' ? { ...project.data, ...translation } : project.data;
const dictionary = copy[locale].detail;
const groupLabels = locale === 'ko' ? { company: '회사 프로젝트', team: '협업 프로젝트', personal: '개인 프로젝트' } : { company: 'Company project', team: 'Team project', personal: 'Personal project' };
const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allProjects.findIndex((item) => item.slug === project.slug);
const nextProject = allProjects[(currentIndex + 1) % allProjects.length];
const nextData = locale === 'en' ? { ...nextProject.data, ...projectEn[projectKey(nextProject.slug)] } : nextProject.data;
const pageTitle = `${data.title} | ${locale === 'ko' ? '박상민 포트폴리오' : 'Park Sangmin Portfolio'}`;
const chapters = locale === 'ko'
  ? headings.filter((heading) => heading.depth === 2).map((heading) => ({ id: heading.slug, title: heading.text }))
  : translation.sections.map((section) => ({ id: section.id, title: section.title }));

---
<BaseLayout locale={locale} title={pageTitle} description={data.summary}>
  <Navbar locale={locale} />
  <main id="main-content" class="project-page">
    <header class="project-hero shell">
      <a class="back-link" href={`${localePath(locale)}#projects`}><svg aria-hidden="true" viewBox="0 0 20 20"><path d="M16 10H4m5-5-5 5 5 5" /></svg>{dictionary.back}</a>
      <h1>{data.title}</h1>
      {data.thesis && <p class="thesis">{data.thesis}</p>}
      <dl class="project-meta">
        <div><dt>{locale === 'ko' ? '구분' : 'Context'}</dt><dd>{groupLabels[project.data.group]}</dd></div>
        <div><dt>{locale === 'ko' ? '담당' : 'Scope'}</dt><dd>{data.responsibility ?? data.role}</dd></div>
        <div><dt>{dictionary.stack}</dt><dd>{data.tech.join(', ')}</dd></div>
      </dl>
    </header>
    <div class="case-layout shell">
      <SectionRail chapters={[...chapters, { id: "trace", title: dictionary.trace }]} label={dictionary.index} />
      <article class="case-content">
        {locale === 'ko' ? <div class="mdx-content"><Content /></div> : translation.sections.map((section) => (
          <section id={section.id} class="content-section">
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p><ProjectText text={paragraph} references={data.traceLinks} /></p>)}
            {englishScreens(key, section.id).map((screen) => <ProjectScreenshot projectKey={key} screen={screen} locale={locale} />)}
            {section.subsections?.map((subsection, subsectionIndex) => <div class="case-subsection">
              <h3>{subsection.title}</h3>
              {subsection.paragraphs.map((paragraph) => <p><ProjectText text={paragraph} references={data.traceLinks} /></p>)}
              {englishScreens(key, section.id, subsectionIndex).map((screen) => <ProjectScreenshot projectKey={key} screen={screen} locale={locale} />)}
              {subsection.items && <ul>{subsection.items.map((item) => <li><ProjectText text={item} references={data.traceLinks} /></li>)}</ul>}
            </div>)}
            {section.links && <div class="project-links">{section.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div>}
            {section.notes && <details class="case-notes">
              <summary>{section.notes.title}</summary>
              {section.notes.paragraphs.map((paragraph) => <p><ProjectText text={paragraph} references={data.traceLinks} /></p>)}
            </details>}
          </section>
        ))}
        <section id="trace" class="trace-section">
          <h2>{dictionary.trace}</h2>
          {data.evidence.length > 0 && <dl class="resource-usage">{data.evidence.map((item) => <div><dt>{item.val}</dt><dd><ProjectText text={item.label} references={data.traceLinks} />{item.detail && <small><ProjectText text={item.detail} references={data.traceLinks} /></small>}</dd></div>)}</dl>}
          <div class="project-links">
            {data.link && <a href={data.link} target="_blank" rel="noopener noreferrer">{dictionary.live}</a>}
            {data.github && <a href={data.github} target="_blank" rel="noopener noreferrer">{dictionary.github}</a>}
            {data.traceLinks.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{locale === 'ko' ? link.label : link.labelEn}</a>)}
          </div>
          {key === 'boundra' && <figure class="screen-evidence">
            <div class="case-visual"><ProjectVisual projectKey={key} locale={locale} variant="detail" /></div>
            <figcaption>{locale === 'ko' ? 'Boundra · CLI 출력 예시' : 'Boundra · Reconstructed CLI output'}</figcaption>
          </figure>}
        </section>
      </article>
    </div>
    <nav class="next-project shell" aria-label={dictionary.next}><span>{dictionary.next}</span><a href={projectPath(locale, nextProject.slug)}>{nextData.title}<svg aria-hidden="true" viewBox="0 0 20 20"><path d="M4 10h12m-5-5 5 5-5 5" /></svg></a></nav>
  </main>
  <Footer locale={locale} />
</BaseLayout>
<style lang="scss">
  @use '../styles/tokens' as *;
  .project-page { padding-top: 76px; }
  .project-hero { padding-top: 48px; padding-bottom: 40px; border-bottom: 1px solid $line; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: $accent; font-size: 14px; }
  svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.4; flex-shrink: 0; }
  h1 { margin-top: 24px; font-size: 48px; font-weight: 600; letter-spacing: -.04em; line-height: 1.25; overflow-wrap: anywhere; }
  .thesis { max-width: 850px; margin-top: 16px; color: $silver; font-size: 24px; line-height: 1.5; letter-spacing: -.025em; word-break: keep-all; }
  .project-meta { display: grid; gap: 14px; margin-top: 40px; }
  .project-meta > div { display: grid; grid-template-columns: 88px minmax(0,1fr); gap: 24px; }
  dt { color: $silver; }dd { color: $silver; font-size: 15px; line-height: 1.8; overflow-wrap: anywhere; }
  .case-layout { display: grid; grid-template-columns: minmax(0,760px); justify-content: center; gap: 48px; padding-top: 48px; }
  .case-content { min-width: 0; }
  .content-section, .trace-section, .case-content :global(.mdx-content > h2) { scroll-margin-top: 108px; }
  .content-section { margin-bottom: 56px; }
  .content-section h2, .trace-section h2, .case-content :global(.mdx-content > h2) { margin-bottom: 20px; font-size: 26px; font-weight: 600; line-height: 1.5; letter-spacing: -.03em; }
  .case-content :global(.mdx-content > h2:not(:first-child)) { margin-top: 56px; }
  .case-subsection h3, .case-content :global(.mdx-content > h3) { margin: 32px 0 16px; font-size: 20px; font-weight: 600; line-height: 1.5; letter-spacing: -.02em; word-break: keep-all; }
  .case-content :global(.mdx-content > h4) { margin: 24px 0 12px; font-size: 18px; }
  .content-section p, .case-subsection ul, .case-content :global(.mdx-content > p), .case-content :global(.mdx-content > ul), .case-content :global(.mdx-content > ol), .case-content :global(.mdx-content > blockquote) { margin-bottom: 20px; color: $silver; font-size: 17px; line-height: 1.9; word-break: keep-all; overflow-wrap: anywhere; }
  .case-subsection ul, .case-content :global(.mdx-content > ul), .case-content :global(.mdx-content > ol) { padding-left: 24px; }
  .case-subsection li + li, .case-content :global(.mdx-content li + li) { margin-top: 10px; }
  .case-content :global(.mdx-content strong) { color: $silver-bright; font-weight: 600; }
  .case-content :global(.mdx-content a), .project-links a { color: $accent; text-decoration: underline; text-underline-offset: 4px; }
  .case-content :global(.mdx-content code) { padding: 2px 5px; background: $black-soft; font: .88em/1.5 $font-mono; overflow-wrap: anywhere; }
  .case-content :global(.mdx-content > pre) { margin: 24px 0; padding: 20px; overflow-x: auto; background: $black-soft; font-size: 14px; }
  .case-content :global(.mdx-content > pre code) { background: transparent; padding: 0; }
  .case-content :global(.mdx-content img) { max-width: 100%; height: auto; }
  .case-content :global(.mdx-content hr) { margin: 32px 0; border: 0; border-top: 1px solid $line; }
  .case-content :global(.mdx-content blockquote) { padding-left: 20px; border-left: 2px solid $line; }
  .trace-section { margin-top: 56px; }
  .case-content :global(.case-notes) { margin: 24px 0 32px; padding: 16px 20px; border: 1px solid $line; background: $black-soft; }
  .case-content :global(.case-notes summary) { cursor: pointer; color: $silver-bright; font-size: 14px; font-weight: 500; line-height: 1.7; }
  .case-content :global(.case-notes p), .case-content :global(.case-notes ul) { margin-top: 16px; color: $silver; font-size: 15px; line-height: 1.85; overflow-wrap: anywhere; }
  .case-content :global(.case-notes ul) { padding-left: 20px; }
  .case-content :global(.case-notes summary:focus-visible) { outline: 2px solid $accent; outline-offset: 4px; }
  .project-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .project-links a { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; }
  .resource-usage { margin: 24px 0; border-top: 1px solid $line; }
  .resource-usage > div { display: grid; grid-template-columns: 150px minmax(0,1fr); gap: 20px; padding: 16px 0; border-bottom: 1px solid $line; }
  .resource-usage dt { color: $silver-bright; font-size: 15px; }.resource-usage small { display: block; color: $gunmetal; font-size: 13px; }
  .screen-evidence { margin: 32px 0 0; }.case-visual { height: 440px; border: 1px solid $line; overflow: hidden; }.case-visual.mobile-screen { max-width: 390px; height: 788px; }
  .case-visual.presence-screen { height: auto; aspect-ratio: 828 / 340; }
  figcaption { margin-top: 14px; color: $gunmetal; font-size: 13px; line-height: 1.8; }
  .next-project { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 32px 0; margin-top: 72px; border-top: 1px solid $line; }.next-project span { color: $gunmetal; font-size: 14px; }.next-project a { display: flex; align-items: center; gap: 12px; min-height: 44px; color: $accent; font-size: 18px; }
  @media (max-width: 760px) { .case-layout { padding-right: 40px; } }
  @media (max-width: 680px) {
    .project-page { padding-top: 68px; }.project-hero { padding-top: 24px; padding-bottom: 28px; }h1 { font-size: 32px; margin-top: 20px; }.thesis { font-size: 20px; }.project-meta { margin-top: 28px; }.project-meta > div { grid-template-columns: 48px minmax(0,1fr); gap: 16px; }dt,dd { font-size: 14px; }
    .case-layout { padding-top: 24px; }.content-section h2, .trace-section h2, .case-content :global(.mdx-content > h2) { font-size: 24px; }.case-subsection h3, .case-content :global(.mdx-content > h3) { font-size: 19px; }.content-section p, .case-subsection ul, .case-content :global(.mdx-content > p), .case-content :global(.mdx-content > ul), .case-content :global(.mdx-content > ol) { font-size: 16px; }
    .resource-usage > div { grid-template-columns: 110px minmax(0,1fr); gap: 16px; }.case-visual { height: 300px; }.case-visual.mobile-screen { height: auto; aspect-ratio: 390 / 788; }.next-project { align-items: start; flex-direction: column; gap: 8px; margin-top: 48px; }
  }
</style>
