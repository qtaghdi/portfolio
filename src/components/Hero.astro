---
import { copy, type Locale } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const dictionary = copy[locale].hero;
const focus = locale === 'ko'
  ? ['제품 전반의 UI 기준', '안전한 인증 흐름', '예측 가능한 데이터 경계']
  : ['Product-wide UI standards', 'Safe authentication flows', 'Predictable data boundaries'];
---

<section id="hero" class="hero">
  <div class="shell hero-grid">
    <div class="hero-copy reveal">
      <p class="hero-label">{dictionary.eyebrow}</p>
      <h1>{dictionary.lines.map((line) => <span>{line}</span>)}</h1>
      <p class="hero-description">{dictionary.description}</p>
      <nav class="hero-actions" aria-label={locale === 'ko' ? '프로필 링크' : 'Profile links'}>
        <a href="#projects">{dictionary.cta}</a>
        <a href="https://github.com/qtaghdi" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:qtaghdi@gmail.com">{locale === 'ko' ? '이메일' : 'Email'}</a>
      </nav>
    </div>

    <aside class="work-note reveal" aria-label={locale === 'ko' ? '현재 관심사' : 'Current focus'}>
      <div class="note-head">
        <span>{locale === 'ko' ? '현재 관심사' : 'Current focus'}</span>
        <i aria-hidden="true"></i>
      </div>
      <ol>
        {focus.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>
        ))}
      </ol>
      <p>{locale === 'ko' ? '대구에서 일하고 있습니다.' : 'Based in Daegu, Korea.'}</p>
    </aside>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;
  .hero { padding: clamp(150px, 17vw, 230px) 0 clamp(88px, 10vw, 138px); border-bottom: 1px solid $line-bright; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(270px, .55fr); gap: clamp(70px, 11vw, 170px); align-items: end; }
  .hero-label { color: $gunmetal; font: 500 .66rem/1.3 $font-mono; letter-spacing: .035em; text-transform: uppercase; }
  h1 { max-width: 980px; margin-top: 31px; font-size: clamp(3.8rem, 7.5vw, 7.8rem); font-weight: 500; line-height: .99; letter-spacing: -.07em; }
  h1 span { display: block; word-break: keep-all; }
  .hero-description { max-width: 680px; margin-top: 44px; color: $silver; font-size: clamp(1.08rem, 1.55vw, 1.32rem); line-height: 1.78; word-break: keep-all; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 25px; margin-top: 33px; }
  .hero-actions a { padding-bottom: 4px; border-bottom: 1px solid $accent; color: $silver-bright; font-size: .78rem; font-weight: 600; }
  .hero-actions a:hover { color: $accent; }
  .work-note { padding-top: 17px; border-top: 1px solid $silver-bright; }
  .note-head { display: flex; align-items: center; justify-content: space-between; color: $gunmetal; font: 500 .63rem/1 $font-mono; }
  .note-head i { width: 7px; height: 7px; border-radius: 50%; background: $accent; }
  .work-note ol { margin-top: 32px; list-style: none; border-bottom: 1px solid $line; }
  .work-note li { display: grid; grid-template-columns: 35px 1fr; gap: 10px; padding: 15px 0; border-top: 1px solid $line; color: $silver; font-size: .9rem; }
  .work-note li span { color: $gunmetal; font: 500 .6rem/1.6 $font-mono; }
  .work-note > p { margin-top: 18px; color: $gunmetal; font: 500 .62rem/1.5 $font-mono; }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 70px; }
    .work-note { max-width: 520px; }
  }
  @media (max-width: 680px) {
    .hero { padding: 124px 0 72px; }
    .hero-grid { gap: 56px; }
    h1 { margin-top: 23px; font-size: clamp(3.25rem, 16vw, 4.9rem); line-height: 1.02; }
    .hero-description { margin-top: 29px; font-size: 1rem; line-height: 1.72; }
    .hero-actions { gap: 20px; margin-top: 25px; }
  }
</style>
