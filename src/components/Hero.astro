---
import { copy, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const dictionary = copy[locale].hero;
---

<section id="hero" class="hero">
  <div class="shell hero-inner">
    <p class="eyebrow reveal">{dictionary.eyebrow}</p>
    <h1 class="reveal">
      <span>{dictionary.lines[0]}</span>
      <span>{dictionary.lines[1]}</span>
      <span class="silver-line">{dictionary.lines[2]}</span>
    </h1>
    <div class="hero-foot reveal">
      <p>{dictionary.description}</p>
      <a href="#projects">
        {dictionary.cta}
        <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M10 3v13M5 11l5 5 5-5" /></svg>
      </a>
    </div>
  </div>
  <span class="hero-index" aria-hidden="true">01</span>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 148px 0 62px;
    border-bottom: 1px solid $line;
  }
  .hero::after {
    content: '';
    position: absolute;
    right: 6.5vw;
    top: 29%;
    width: min(31vw, 450px);
    height: 1px;
    background: linear-gradient(90deg, transparent, $line-bright);
  }
  .hero-inner { position: relative; }
  h1 {
    max-width: 1180px;
    margin-top: 28px;
    font-size: clamp(4rem, 9.1vw, 9.2rem);
    font-weight: 500;
    line-height: .95;
    letter-spacing: -.075em;
  }
  h1 span { display: block; word-break: keep-all; }
  .silver-line {
    width: fit-content;
    color: $silver;
    background: linear-gradient(105deg, $gunmetal 0%, $silver-bright 46%, $gunmetal 76%);
    background-size: 220% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-foot {
    display: grid;
    grid-template-columns: minmax(280px, 560px) auto;
    align-items: end;
    justify-content: space-between;
    gap: 60px;
    margin-top: clamp(52px, 8vh, 96px);
  }
  .hero-foot p { max-width: 560px; color: $silver; font-size: clamp(1rem, 1.35vw, 1.18rem); line-height: 1.8; word-break: keep-all; }
  .hero-foot a {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    padding-bottom: 8px;
    border-bottom: 1px solid $silver;
    color: $silver;
    font: 500 .72rem/1 $font-mono;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .hero-foot svg { width: 16px; fill: none; stroke: currentColor; stroke-width: 1.3; }
  .hero-index { position: absolute; right: 28px; bottom: 28px; color: $line-bright; font: 500 .62rem/1 $font-mono; }
  @media (prefers-reduced-motion: no-preference) {
    .visible .silver-line { animation: sheen 1.4s 420ms ease both; }
    @keyframes sheen { from { background-position: 100% 0; } to { background-position: 0 0; } }
  }
  @media (max-width: 760px) {
    .hero { min-height: 780px; padding: 120px 0 42px; }
    .hero::after { top: 24%; width: 34vw; }
    h1 { font-size: clamp(3.05rem, 12.5vw, 5rem); line-height: 1.03; }
    .hero-foot { grid-template-columns: 1fr; gap: 34px; }
    .hero-foot a { justify-self: start; }
    .hero-index { display: none; }
  }
</style>
