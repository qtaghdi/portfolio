---
import { copy, type Locale } from '../i18n';
import { getGitHubProfile } from '../lib/github-profile.mjs';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const dictionary = copy[locale].hero;
const profile = await getGitHubProfile();
---
<section id="hero" class="hero">
  <div class="shell">
    <a class="github-profile" href={profile.url} target="_blank" rel="noopener noreferrer" aria-label={locale === 'ko' ? `${profile.name}의 GitHub 프로필` : `${profile.name}'s GitHub profile`}>
      <img src={profile.avatarUrl} alt={locale === 'ko' ? `${profile.name} GitHub 프로필 사진` : `${profile.name}'s GitHub avatar`} width="44" height="44" decoding="async" />
      <span><strong>@{profile.login}</strong><small>GitHub</small></span>
      <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M5 15 15 5M5 5h10v10" /></svg>
    </a>
    <h1>{dictionary.lines.map((line) => <span>{line}</span>)}</h1>
    <p class="hero-description">{dictionary.description.split(/(?<=\.)\s+/).map((sentence) => <span>{sentence}</span>)}</p>
    <nav class="hero-actions" aria-label={locale === 'ko' ? '프로필 링크' : 'Profile links'}>
      <a href="#projects">{dictionary.cta}</a>
      <a href="https://github.com/qtaghdi" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>
</section>
<style lang="scss">
  @use '../styles/tokens' as *;
  .hero { padding: 156px 0 100px; }
  .github-profile { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 28px; width: fit-content; }
  .github-profile img { width: 44px; height: 44px; object-fit: cover; border-radius: 50%; background: $black-soft; }
  .github-profile strong { display: block; color: $silver-bright; font-size: 15px; font-weight: 500; line-height: 1.4; }
  .github-profile small { display: block; margin-top: 3px; color: $gunmetal; font-size: 12px; line-height: 1.4; }
  .github-profile svg { width: 16px; height: 16px; margin-left: 8px; fill: none; stroke: $gunmetal; stroke-width: 1.3; }
  .github-profile:hover strong, .github-profile:hover svg { color: $accent; stroke: $accent; }
  h1 { font-size: 56px; font-weight: 600; line-height: 1.35; letter-spacing: -.045em; }
  h1 span, .hero-description span { display: block; }
  .hero-description { margin-top: 40px; color: $silver; font-size: 18px; line-height: 1.85; word-break: keep-all; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 30px; margin-top: 28px; }
  .hero-actions a { display: inline-flex; align-items: center; min-height: 44px; color: $accent; font-size: 16px; text-decoration: underline; text-underline-offset: 5px; }
  .hero-actions a:hover { color: $accent-dark; }
  @media (max-width: 680px) {
    .hero { padding: 112px 0 72px; }
    .github-profile { margin-bottom: 24px; }
    h1 { font-size: clamp(30px, 8vw, 36px); line-height: 1.4; }
    .hero-description { margin-top: 28px; font-size: 16px; line-height: 1.85; }
    .hero-actions { margin-top: 20px; gap: 28px; }
  }
</style>
